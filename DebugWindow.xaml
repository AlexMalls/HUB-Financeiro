<Window x:Class="HubFinanceiro.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modo Debug - Hub Financeiro"
        Width="1040"
        Height="620"
        MinWidth="760"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#151515"
        Foreground="White">

    <Window.Resources>
        <SolidColorBrush x:Key="DebugSurface" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="DebugSurfaceAlt" Color="#252526"/>
        <SolidColorBrush x:Key="DebugBorder" Color="#343438"/>
        <SolidColorBrush x:Key="DebugAccent" Color="#7920DC"/>

        <Style x:Key="DebugButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A2A2D"/>
            <Setter Property="BorderBrush" Value="#45454B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#38383D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#202023"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="#61D095" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Modo Debug ativo"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Ações, contexto de negócio e alterações em arquivos são correlacionados em tempo real."
                           Foreground="#AFAFB5"
                           FontSize="12"
                           Margin="17,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PauseButton"
                        Content="Pausar exibição"
                        Style="{StaticResource DebugButtonStyle}"
                        Click="PauseButton_Click"/>
                <Button Content="Limpar tela"
                        Style="{StaticResource DebugButtonStyle}"
                        Click="ClearButton_Click"/>
                <Button Content="Abrir logs"
                        Style="{StaticResource DebugButtonStyle}"
                        Click="OpenLogsButton_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource DebugSurfaceAlt}"
                BorderBrush="{StaticResource DebugBorder}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="10,7"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="LIVE"
                           Foreground="#61D095"
                           FontWeight="Bold"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Aguardando eventos..."
                           Foreground="#C5C5CA"
                           FontSize="12"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
                <CheckBox x:Name="AutoScrollCheckBox"
                          Grid.Column="2"
                          Content="Seguir eventos"
                          IsChecked="True"
                          Foreground="#D8D8DC"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#101010"
                BorderBrush="{StaticResource DebugBorder}"
                BorderThickness="1"
                CornerRadius="7">
            <ListBox x:Name="LogList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#E5E5E5"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="8"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}"
                                   TextWrapping="NoWrap"
                                   Margin="0,1"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="2,9,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Rotina = contexto • UI = interação • arquivo/JSON = efeito real • log = últimas 10.000 linhas"
                       Foreground="#77777E"
                       FontSize="11"/>
            <TextBlock x:Name="CounterText"
                       Grid.Column="1"
                       Text="0 eventos"
                       Foreground="#9999A0"
                       FontSize="11"/>
        </Grid>
    </Grid>
</Window>
