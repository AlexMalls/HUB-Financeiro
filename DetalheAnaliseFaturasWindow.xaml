<Window x:Class="HubFinanceiro.DetalheAnaliseFaturasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HubFinanceiro"
        Title="Detalhes da análise"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinWidth="1050"
        MinHeight="620"
        Width="1320"
        Height="780"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#7920DC"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#202024"/>
        <SolidColorBrush x:Key="MutedTextColor" Color="#96969F"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3B3B41"/>
        <SolidColorBrush x:Key="GridBorderColor" Color="#3A3A40"/>
        <SolidColorBrush x:Key="SelectionPurple" Color="#7A3FA0"/>
        <SolidColorBrush x:Key="ScrollbarColor" Color="#6E6E6E"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#70D6A0"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F2C879"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#FF7777"/>
        <SolidColorBrush x:Key="CloseButtonHover" Color="#C42B1C"/>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.Thumb><Thumb Background="Transparent"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="T" Background="{StaticResource ScrollbarColor}" CornerRadius="4" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#8A6AA0"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="T" Property="Background" Value="{StaticResource PrimaryColor}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="8"/><Setter Property="Width" Value="Auto"/><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="CloseWindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D0D0D5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder" Background="{TemplateBinding Background}" CornerRadius="0,11,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="{StaticResource CloseButtonHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseBorder" Property="Opacity" Value="0.82"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="#DEDEE4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridBorderColor}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource GridBorderColor}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>

        <Style TargetType="DataGridCell"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{StaticResource GridBorderColor}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="8,4"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#4B2566"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#29292E"/><Setter Property="Foreground" Value="#DADAE0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="{StaticResource GridBorderColor}"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="8,5"/></Style>
        <Style TargetType="DataGridRow"><Setter Property="Background" Value="{StaticResource SurfaceColor}"/><Setter Property="Foreground" Value="#DEDEE4"/><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#232328"/></Trigger></Style.Triggers></Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#BEBEC5"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="14,8"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundDark}" BorderBrush="#45454C" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#242426" CornerRadius="11,11,0,0" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Investigação da análise" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0"/>
                    <Button HorizontalAlignment="Right" Content="✕" FontSize="15" Style="{StaticResource CloseWindowButtonStyle}" Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#26262B" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="BeneficiarioText" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SubtituloText" Foreground="{StaticResource MutedTextColor}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="ValoresText" Foreground="#C8C8CE" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Resumo">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,14,0,0">
                                <Border Background="{StaticResource BackgroundMedium}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Breve explicação" Foreground="#B98AF0" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BreveExplicacaoText" Foreground="#D6D6DC" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        <TextBlock x:Name="ResumoDevolucaoText" Visibility="Collapsed" Foreground="#D6D6DC" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BackgroundMedium}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                    <StackPanel><TextBlock Text="Origem da fatura" Foreground="#B98AF0" FontWeight="SemiBold"/><TextBlock x:Name="OrigemFaturaText" Foreground="#D6D6DC" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                </Border>
                                <Border Background="{StaticResource BackgroundMedium}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                    <StackPanel><TextBlock Text="Origem do Over" Foreground="#B98AF0" FontWeight="SemiBold"/><TextBlock x:Name="OrigemOverText" Foreground="#D6D6DC" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                </Border>
                                <Border Background="{StaticResource BackgroundMedium}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="9" Padding="14">
                                    <StackPanel><TextBlock Text="Dados do beneficiário na fatura" Foreground="#B98AF0" FontWeight="SemiBold"/><TextBlock x:Name="DadosFaturaText" Foreground="#D6D6DC" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Lançamentos">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{StaticResource BackgroundMedium}"
                                    BorderBrush="{StaticResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock x:Name="LancamentosTituloText"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="LancamentosResumoText"
                                               Foreground="{StaticResource MutedTextColor}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LancamentosOrigemText"
                                               Foreground="#BEBEC5"
                                               FontSize="10"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Componentes da Fatura"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="LancamentosTotalFaturaText"
                                                   Foreground="{StaticResource SuccessColor}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="LancamentosTotalFaturaAuxText"
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="2"
                                        Background="{StaticResource SurfaceColor}"
                                        BorderBrush="#44444B"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        ClipToBounds="True">
                                    <DataGrid x:Name="FaturaDataGrid"
                                              local:DataGridCopiavelBehavior.Habilitado="True"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="True"
                                              CanUserResizeColumns="True"
                                              CanUserSortColumns="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="All"
                                              AlternationCount="2"
                                              RowHeight="30"
                                              ColumnHeaderHeight="30"
                                              Background="{StaticResource SurfaceColor}"
                                              Foreground="#DEDEE4"
                                              HorizontalGridLinesBrush="{StaticResource GridBorderColor}"
                                              VerticalGridLinesBrush="{StaticResource GridBorderColor}"
                                              BorderThickness="0"
                                              RowHeaderWidth="0"
                                              SelectionMode="Extended"
                                              SelectionUnit="Cell"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.CanContentScroll="True">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
                                                <Setter Property="Foreground" Value="#DEDEE4"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="AlternationIndex" Value="1">
                                                        <Setter Property="Background" Value="#232327"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding ContextoTemporal}" Value="True">
                                                        <Setter Property="Foreground" Value="#BEBEC5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Fatura" Binding="{Binding Fatura}" Width="85"/>
                                            <DataGridTextColumn Header="Arquivo" Binding="{Binding Arquivo}" Width="330"/>
                                            <DataGridTextColumn Header="Pág. PDF" Binding="{Binding PaginaPdf}" Width="72"/>
                                            <DataGridTextColumn Header="Pág. Fat." Binding="{Binding PaginaFatura}" Width="72"/>
                                            <DataGridTextColumn Header="Subfat." Binding="{Binding Subfatura}" Width="68"/>
                                            <DataGridTextColumn Header="Entidade" Binding="{Binding Entidade}" Width="120"/>
                                            <DataGridTextColumn Header="MOV" Binding="{Binding Movimento}" Width="58"/>
                                            <DataGridTextColumn Header="Competência" Binding="{Binding Competencia}" Width="90"/>
                                            <DataGridTextColumn Header="Natureza" Binding="{Binding Natureza}" Width="190"/>
                                            <DataGridTextColumn Header="Plano" Binding="{Binding Plano}" Width="90"/>
                                            <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="95"/>
                                            <DataGridTextColumn Header="Participação" Binding="{Binding Participacao}" Width="95"/>
                                            <DataGridTextColumn Header="Uso na comparação" Binding="{Binding Uso}" Width="190"/>
                                            <DataGridTextColumn Header="Texto origem" Binding="{Binding TextoOrigem}" Width="360"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Componentes do Over"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="LancamentosTotalOverText"
                                                   Foreground="{StaticResource SuccessColor}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="LancamentosTotalOverAuxText"
                                                   Foreground="{StaticResource MutedTextColor}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="2"
                                        Background="{StaticResource SurfaceColor}"
                                        BorderBrush="#44444B"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        ClipToBounds="True">
                                    <DataGrid x:Name="OverDataGrid"
                                              local:DataGridCopiavelBehavior.Habilitado="True"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="True"
                                              CanUserResizeColumns="True"
                                              CanUserSortColumns="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="All"
                                              AlternationCount="2"
                                              RowHeight="30"
                                              ColumnHeaderHeight="30"
                                              Background="{StaticResource SurfaceColor}"
                                              Foreground="#DEDEE4"
                                              HorizontalGridLinesBrush="{StaticResource GridBorderColor}"
                                              VerticalGridLinesBrush="{StaticResource GridBorderColor}"
                                              BorderThickness="0"
                                              RowHeaderWidth="0"
                                              SelectionMode="Extended"
                                              SelectionUnit="Cell"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.CanContentScroll="True">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
                                                <Setter Property="Foreground" Value="#DEDEE4"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="AlternationIndex" Value="1">
                                                        <Setter Property="Background" Value="#232327"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IgnoradoNoComparavel}" Value="True">
                                                        <Setter Property="Opacity" Value="0.42"/>
                                                        <Setter Property="Foreground" Value="{StaticResource MutedTextColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Linha" Binding="{Binding Linha}" Width="68"/>
                                            <DataGridTextColumn Header="Evento" Binding="{Binding Evento}" Width="72"/>
                                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="270"/>
                                            <DataGridTextColumn Header="Competência" Binding="{Binding Competencia}" Width="90"/>
                                            <DataGridTextColumn Header="Natureza" Binding="{Binding Natureza}" Width="165"/>
                                            <DataGridTextColumn Header="Uso na comparação" Binding="{Binding Uso}" Width="190"/>
                                            <DataGridTextColumn Header="PV" Binding="{Binding PV}" Width="95"/>
                                            <DataGridTextColumn Header="NET" Binding="{Binding NET}" Width="95"/>
                                            <DataGridTextColumn Header="Over" Binding="{Binding Over}" Width="95"/>
                                            <DataGridTextColumn Header="Entidade" Binding="{Binding Entidade}" Width="120"/>
                                            <DataGridTextColumn Header="Matrícula" Binding="{Binding Matricula}" Width="160"/>
                                            <DataGridTextColumn Header="Cartão" Binding="{Binding Cartao}" Width="150"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Regras testadas">
                        <Border Margin="0,14,0,0" Background="{StaticResource SurfaceColor}" BorderBrush="#44444B" BorderThickness="1" CornerRadius="9" Padding="1">
                            <DataGrid x:Name="RegrasDataGrid" local:DataGridCopiavelBehavior.Habilitado="True" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All" AlternationCount="2" RowHeight="44" ColumnHeaderHeight="32" BorderThickness="0" RowHeaderWidth="0" SelectionMode="Extended" SelectionUnit="Cell" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          Background="{StaticResource SurfaceColor}">
                                <DataGrid.Columns><DataGridTextColumn Header="Regra" Binding="{Binding Regra}" Width="180"/><DataGridTextColumn Header="Resultado" Binding="{Binding Resultado}" Width="125"/><DataGridTextColumn Header="Condição" Binding="{Binding Condicao}" Width="320"/><DataGridTextColumn Header="Dados utilizados" Binding="{Binding Dados}" Width="240"/><DataGridTextColumn Header="Justificativa" Binding="{Binding Justificativa}" Width="450"/><DataGridTextColumn Header="Evidências" Binding="{Binding Evidencias}" Width="500"/></DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Contexto temporal">
                        <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="ContextoResumoText" Foreground="#D0D0D6" TextWrapping="Wrap"/>
                            <Border Grid.Row="2" Background="{StaticResource SurfaceColor}" BorderBrush="#44444B" BorderThickness="1" CornerRadius="9" Padding="1">
                                <DataGrid x:Name="ContextoDataGrid" local:DataGridCopiavelBehavior.Habilitado="True" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All" AlternationCount="2" RowHeight="32" ColumnHeaderHeight="32" BorderThickness="0" RowHeaderWidth="0" SelectionMode="Extended" SelectionUnit="Cell" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                          Background="{StaticResource SurfaceColor}">
                                    <DataGrid.Columns><DataGridTextColumn Header="Fatura" Binding="{Binding CompetenciaFatura}" Width="85"/><DataGridTextColumn Header="Arquivo" Binding="{Binding Arquivo}" Width="280"/><DataGridTextColumn Header="Subf." Binding="{Binding Subfatura}" Width="60"/><DataGridTextColumn Header="Pág." Binding="{Binding Pagina}" Width="60"/><DataGridTextColumn Header="MOV" Binding="{Binding Movimento}" Width="60"/><DataGridTextColumn Header="Competência lançamento" Binding="{Binding CompetenciaLancamento}" Width="135"/><DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="95"/><DataGridTextColumn Header="Entidade" Binding="{Binding Entidade}" Width="140"/></DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
