<Window x:Class="HubFinanceiro.ProvisionamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Provisionamento de Pagamentos"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        Width="1100"
        Height="650"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#7920dc"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="TextColor" Color="White"/>
        <SolidColorBrush x:Key="CloseButtonHover" Color="#C42B1C"/>
        
        <!-- Estilo do Botão Fechar igual ao MainWindow -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="0,18,0,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CloseButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{StaticResource BackgroundDark}"
            BorderBrush="{StaticResource PrimaryColor}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra Superior -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundLight}"
                    Padding="2"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Border Background="{StaticResource BackgroundMedium}"
                        CornerRadius="18,18,0,0">
                    <Grid>
                        <TextBlock Text="Provisionamento"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"
                                   Foreground="{StaticResource TextColor}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                Style="{StaticResource CloseButtonStyle}"
                                Click="Close_Click"/>
                    </Grid>
                </Border>
            </Border>

            <!-- Conteúdo Principal -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ADMINISTRADORA (Esquerda) -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource BackgroundMedium}"
                        CornerRadius="10"
                        BorderBrush="{StaticResource PrimaryColor}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                Background="{StaticResource PrimaryColor}"
                                CornerRadius="10,10,0,0"
                                Padding="15,10">
                            <TextBlock Text="ADMINISTRADORA"
                                      Foreground="White"
                                      FontSize="16"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Lista -->
                        <ScrollViewer Grid.Row="1"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="10">
                            <ItemsControl x:Name="AdministradoraItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BackgroundLight}"
                                                CornerRadius="5"
                                                Padding="10,8"
                                                Margin="0,0,0,5"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="ItemAdm_MouseLeftButtonDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Nome -->
                                                <TextBlock Grid.Column="0"
                                                          Text="{Binding NomeFornecedor}"
                                                          Foreground="{StaticResource TextColor}"
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"/>

                                                <!-- Data -->
                                                <TextBlock Grid.Column="1"
                                                          Text="{Binding DataPagamento, StringFormat=dd/MM/yyyy}"
                                                          Foreground="#999999"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"
                                                          Margin="10,0"/>

                                                <!-- Valor -->
                                                <TextBlock Grid.Column="2"
                                                          Foreground="#4CAF50"
                                                          FontSize="13"
                                                          FontWeight="Bold"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0">
                                                    <Run Text="R$ "/>
                                                    <Run Text="{Binding Valor, StringFormat=N2}"/>
                                                </TextBlock>
                                                
                                                <!-- Badge de Status -->
                                                <Border Grid.Column="3"
                                                       CornerRadius="10"
                                                       Padding="8,4"
                                                       VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pendente">
                                                                    <Setter Property="Background" Value="#FFA500"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="No Banco">
                                                                    <Setter Property="Background" Value="#47bddb"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}"
                                                              Foreground="White"
                                                              FontSize="11"
                                                              FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- RODAPÉ - Totais ADM -->
                        <Border Grid.Row="2"
                                Background="{StaticResource BackgroundDark}"
                                BorderBrush="{StaticResource PrimaryColor}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,10,10"
                                Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                          Text="Valor:"
                                          Foreground="#999999"
                                          FontSize="12"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                          x:Name="TotalAdmTextBlock"
                                          Text="R$ 0,00"
                                          Foreground="#4CAF50"
                                          FontSize="14"
                                          FontWeight="Bold"
                                          Margin="5,0,15,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                          Foreground="#999999"
                                          FontSize="12"
                                          VerticalAlignment="Center">
                                    <Run Text="Quant:"/>
                                    <Run x:Name="QuantAdmTextBlock" Text="0" FontWeight="Bold" Foreground="{StaticResource TextColor}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- CORRETORA (Direita) -->
                <Border Grid.Row="0" Grid.Column="2"
                        Background="{StaticResource BackgroundMedium}"
                        CornerRadius="10"
                        BorderBrush="{StaticResource PrimaryColor}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                Background="{StaticResource PrimaryColor}"
                                CornerRadius="10,10,0,0"
                                Padding="15,10">
                            <TextBlock Text="CORRETORA"
                                      Foreground="White"
                                      FontSize="16"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Lista -->
                        <ScrollViewer Grid.Row="1"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="10">
                            <ItemsControl x:Name="CorretoraItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BackgroundLight}"
                                                CornerRadius="5"
                                                Padding="10,8"
                                                Margin="0,0,0,5"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="ItemCor_MouseLeftButtonDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Nome -->
                                                <TextBlock Grid.Column="0"
                                                          Text="{Binding NomeFornecedor}"
                                                          Foreground="{StaticResource TextColor}"
                                                          FontSize="13"
                                                          FontWeight="SemiBold"
                                                          VerticalAlignment="Center"
                                                          TextTrimming="CharacterEllipsis"/>

                                                <!-- Data -->
                                                <TextBlock Grid.Column="1"
                                                          Text="{Binding DataPagamento, StringFormat=dd/MM/yyyy}"
                                                          Foreground="#999999"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"
                                                          Margin="10,0"/>

                                                <!-- Valor -->
                                                <TextBlock Grid.Column="2"
                                                          Foreground="#4CAF50"
                                                          FontSize="13"
                                                          FontWeight="Bold"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0">
                                                    <Run Text="R$ "/>
                                                    <Run Text="{Binding Valor, StringFormat=N2}"/>
                                                </TextBlock>
                                                
                                                <!-- Badge de Status -->
                                                <Border Grid.Column="3"
                                                       CornerRadius="10"
                                                       Padding="8,4"
                                                       VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pendente">
                                                                    <Setter Property="Background" Value="#FFA500"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="No Banco">
                                                                    <Setter Property="Background" Value="#47bddb"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}"
                                                              Foreground="White"
                                                              FontSize="11"
                                                              FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- RODAPÉ - Totais COR -->
                        <Border Grid.Row="2"
                                Background="{StaticResource BackgroundDark}"
                                BorderBrush="{StaticResource PrimaryColor}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,10,10"
                                Padding="15,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                          Text="Valor:"
                                          Foreground="#999999"
                                          FontSize="12"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                          x:Name="TotalCorTextBlock"
                                          Text="R$ 0,00"
                                          Foreground="#4CAF50"
                                          FontSize="14"
                                          FontWeight="Bold"
                                          Margin="5,0,15,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                          Foreground="#999999"
                                          FontSize="12"
                                          VerticalAlignment="Center">
                                    <Run Text="Quant:"/>
                                    <Run x:Name="QuantCorTextBlock" Text="0" FontWeight="Bold" Foreground="{StaticResource TextColor}"/>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Botão Provisionar (embaixo à direita, fora das listas) -->
                <Button Content="Provisionar Pagamentos"
                        Grid.Row="1"
                        Grid.Column="2"
                        Width="200"
                        Height="45"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0"
                        Background="{StaticResource PrimaryColor}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Provisionar_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#5e17aa"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
