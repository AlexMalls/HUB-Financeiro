<Window x:Class="HubFinanceiro.ConfirmarNotaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar Nota"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor"      Color="#7920dc"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#5e17aa"/>
        <SolidColorBrush x:Key="BackgroundDark"    Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium"  Color="#252526"/>
        <SolidColorBrush x:Key="BackgroundLight"   Color="#2A2A2D"/>
        <SolidColorBrush x:Key="BorderColor"       Color="#2D2D30"/>
        <SolidColorBrush x:Key="TextColor"         Color="White"/>
        <SolidColorBrush x:Key="CloseButtonHover"  Color="#C42B1C"/>
    </Window.Resources>

    <Border CornerRadius="15"
            Background="{StaticResource BackgroundDark}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1">

        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- título -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/> <!-- pergunta -->
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/> <!-- painel de dados -->
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/> <!-- botões -->
            </Grid.RowDefinitions>

            <!-- Título com ícone -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="?"
                           FontSize="24"
                           Foreground="{StaticResource PrimaryColor}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleTextBlock"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextColor}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Pergunta -->
            <TextBlock Grid.Row="2"
                       Text="Confirma a importação da nota fiscal para a O.P.E.X?"
                       FontSize="13"
                       Foreground="{StaticResource TextColor}"
                       TextWrapping="Wrap"/>

            <!-- Painel de dados -->
            <Border Grid.Row="4"
                    Background="{StaticResource BackgroundMedium}"
                    CornerRadius="8"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Fornecedor -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Fornecedor:" 
                               Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="FornecedorTextBlock" Grid.Row="0" Grid.Column="2"
                               Foreground="{StaticResource TextColor}" FontSize="13" TextWrapping="Wrap"/>

                    <!-- Nota Nº -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Nota Nº:" 
                               Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="NumeroNotaTextBlock" Grid.Row="2" Grid.Column="2"
                               Foreground="{StaticResource TextColor}" FontSize="13"/>

                    <!-- Emitida em -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Emitida em:" 
                               Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="DataEmissaoTextBlock" Grid.Row="4" Grid.Column="2"
                               Foreground="{StaticResource TextColor}" FontSize="13"/>

                    <!-- Valor -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Valor:" 
                               Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="ValorTextBlock" Grid.Row="6" Grid.Column="2"
                               Foreground="{StaticResource TextColor}" FontSize="13"/>

                    <!-- Data Pagamento (editável) -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Data Pagamento:" 
                               Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="13"/>
                    <Grid Grid.Row="8" Grid.Column="2">
                        <!-- Label (modo leitura) -->
                        <StackPanel x:Name="DataLabelPanel" Orientation="Horizontal"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="DataLabel_DoubleClick"
                                    ToolTip="Clique duas vezes para editar">
                            <TextBlock x:Name="DataPagamentoTextBlock"
                                       Foreground="{StaticResource TextColor}" FontSize="13"/>
                            <TextBlock Text="  ✎"
                                       Foreground="#555555" FontSize="11"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <!-- TextBox (modo edição) -->
                        <Border x:Name="DataEditBorder"
                                Background="{StaticResource BackgroundDark}"
                                BorderBrush="{StaticResource PrimaryColor}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="Collapsed">
                            <TextBox x:Name="DataPagamentoTextBox"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextColor}"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Padding="6,3"
                                     MaxLength="10"
                                     Width="100"
                                     LostFocus="DataTextBox_LostFocus"
                                     KeyDown="DataTextBox_KeyDown"
                                     TextChanged="DataTextBox_TextChanged"/>
                        </Border>
                    </Grid>

                    <!-- Empresa -->
                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Empresa:" 
                               Foreground="{StaticResource PrimaryColor}" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="EmpresaTextBlock" Grid.Row="10" Grid.Column="2"
                               Foreground="{StaticResource TextColor}" FontSize="13"/>
                </Grid>
            </Border>

            <!-- Botões -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SimButton"
                        Content="Sim"
                        Width="100" Height="35"
                        Margin="0,0,8,0"
                        Cursor="Hand"
                        Click="Sim_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="15,8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="NaoButton"
                        Content="Não"
                        Width="100" Height="35"
                        Cursor="Hand"
                        Click="Nao_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3A3A3A"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="15,8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4A4A4A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
