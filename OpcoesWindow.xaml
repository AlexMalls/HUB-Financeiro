<Window x:Class="HubFinanceiro.OpcoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opções - Hub Financeiro"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Width="600"
        Height="400"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Cores do Tema -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#7920dc"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#5e17aa"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2D2D30"/>
        <SolidColorBrush x:Key="AccentColor" Color="#633884"/>
        <SolidColorBrush x:Key="TextColor" Color="White"/>
        <SolidColorBrush x:Key="CloseButtonHover" Color="#C42B1C"/>

        <!-- Estilo do Botão Fechar -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,20,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CloseButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo dos ToggleButtons da Sidebar -->
        <Style x:Key="SidebarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Margin" Value="10,8,10,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{DynamicResource BackgroundDark}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- Barra superior -->
                <RowDefinition Height="*"/>  <!-- Conteúdo principal -->
            </Grid.RowDefinitions>

            <!-- Barra Superior -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BackgroundLight}"
                    Padding="2"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">

                <Border Background="{DynamicResource BackgroundMedium}"
                        CornerRadius="18,18,0,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- Título -->
                        <TextBlock Text="Opções"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"
                                   Foreground="{DynamicResource TextColor}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <!-- Botão Fechar -->
                        <Button Content="✕"
                                Grid.Column="1"
                                Style="{StaticResource CloseButtonStyle}"
                                Click="Close_Click"/>
                    </Grid>
                </Border>
            </Border>

            <!-- Área Principal -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/> <!-- Barra lateral -->
                    <ColumnDefinition Width="*"/>   <!-- Área de conteúdo -->
                </Grid.ColumnDefinitions>

                <!-- Barra Lateral -->
                <Border Grid.Column="0" 
                        Background="{DynamicResource BackgroundMedium}" 
                        CornerRadius="0,0,0,20"
                        Padding="0,10,0,0">
                    <StackPanel>
                        <ToggleButton x:Name="GeralButton"
                                    Content="Geral" 
                                    Style="{StaticResource SidebarToggleButtonStyle}" 
                                    Click="GeralButton_Click"
                                    IsChecked="True"/>
                    </StackPanel>
                </Border>

                <!-- Área de Conteúdo -->
                <Border Grid.Column="1" 
                        Background="{DynamicResource BackgroundDark}" 
                        CornerRadius="0,0,20,0"
                        Padding="20">
                    
                    <!-- Conteúdo Geral -->
                    <StackPanel x:Name="GeralContent" 
                               Visibility="Visible"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center">
                        <TextBlock Text="Ainda não há opções de configuração"
                                  Foreground="{DynamicResource TextColor}"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  TextAlignment="Center"
                                  Opacity="0.6"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
