<Window x:Class="HubFinanceiro.OpcoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opções - Hub Financeiro"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Width="720"
        Height="470"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#7920dc"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#5e17aa"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2D2D30"/>
        <SolidColorBrush x:Key="AccentColor" Color="#633884"/>
        <SolidColorBrush x:Key="TextColor" Color="White"/>
        <SolidColorBrush x:Key="CloseButtonHover" Color="#C42B1C"/>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,20,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CloseButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Margin" Value="10,8,10,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#49494F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#38383D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{DynamicResource BackgroundDark}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource BackgroundLight}"
                    Padding="2"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Border Background="{DynamicResource BackgroundMedium}"
                        CornerRadius="18,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Opções"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"
                                   Foreground="{DynamicResource TextColor}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <Button Content="✕"
                                Grid.Column="1"
                                Style="{StaticResource CloseButtonStyle}"
                                Click="Close_Click"/>
                    </Grid>
                </Border>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource BackgroundMedium}"
                        CornerRadius="0,0,0,20"
                        Padding="0,10,0,0">
                    <StackPanel>
                        <ToggleButton x:Name="GeralButton"
                                      Content="Geral"
                                      Style="{StaticResource SidebarToggleButtonStyle}"
                                      Click="GeralButton_Click"
                                      IsChecked="True"/>
                        <ToggleButton x:Name="DebugButton"
                                      Content="Debug"
                                      Style="{StaticResource SidebarToggleButtonStyle}"
                                      Click="DebugButton_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource BackgroundDark}"
                        CornerRadius="0,0,20,0"
                        Padding="28">
                    <Grid>
                        <StackPanel x:Name="GeralContent"
                                    Visibility="Visible"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Configurações gerais"
                                       Foreground="{DynamicResource TextColor}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Ainda não há opções gerais de configuração."
                                       Foreground="{DynamicResource TextColor}"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       Opacity="0.55"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="DebugContent" Visibility="Collapsed">
                            <TextBlock Text="Modo Debug"
                                       Foreground="{DynamicResource TextColor}"
                                       FontSize="21"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Acompanhe em tempo real as ações visuais e processos internos executados pelo HUB."
                                       Foreground="{DynamicResource TextColor}"
                                       FontSize="13"
                                       Opacity="0.65"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,22"/>

                            <Border Background="{DynamicResource BackgroundMedium}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Ativar monitoramento"
                                                   Foreground="{DynamicResource TextColor}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Mantém o debug ativo mesmo quando o console estiver fechado."
                                                   Foreground="{DynamicResource TextColor}"
                                                   FontSize="12"
                                                   Opacity="0.55"
                                                   Margin="0,4,12,0"/>
                                    </StackPanel>

                                    <CheckBox x:Name="DebugModeCheckBox"
                                              Grid.Column="1"
                                              Width="20"
                                              Height="20"
                                              VerticalAlignment="Center"
                                              Checked="DebugModeCheckBox_Changed"
                                              Unchecked="DebugModeCheckBox_Changed"/>

                                    <StackPanel Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                Margin="0,18,0,0">
                                        <Ellipse x:Name="DebugStatusDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="#77777E"
                                                 Margin="0,0,7,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DebugStatusText"
                                                   Text="Desativado"
                                                   Foreground="{DynamicResource TextColor}"
                                                   FontSize="12"
                                                   Opacity="0.75"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="OpenDebugConsoleButton"
                                        Content="Abrir console"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="OpenDebugConsoleButton_Click"
                                        Margin="0,0,10,0"/>
                                <Button Content="Abrir pasta de logs"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="OpenDebugLogsButton_Click"/>
                            </StackPanel>

                            <TextBlock Text="O histórico é gravado em arquivo separado. Campos digitados não são registrados pelo capturador de interface."
                                       Foreground="{DynamicResource TextColor}"
                                       FontSize="11"
                                       Opacity="0.45"
                                       TextWrapping="Wrap"
                                       Margin="0,18,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
