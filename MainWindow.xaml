<Window x:Class="HubFinanceiro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hfaux="clr-namespace:HubFinanceiro"
        Title="Hub Financeiro"
        Icon="icone.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        Loaded="Window_Loaded"
        MinWidth="800"
        MinHeight="600">

    <Window.Resources>
        
        <!-- ============================================ -->
        <!-- CORES DO TEMA -->
        <!-- ============================================ -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#7920dc"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#5e17aa"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2D2D30"/>
        <SolidColorBrush x:Key="AccentColor" Color="#633884"/>
        <SolidColorBrush x:Key="TextColor" Color="White"/>
        <SolidColorBrush x:Key="CloseButtonHover" Color="#C42B1C"/>
        <SolidColorBrush x:Key="ScrollbarColor" Color="#6E6E6E"/>
        
        <!-- ============================================ -->
        <!-- GRADIENTE ANIMADO DA SIDEBAR (espaço/universo) -->
        <!-- ============================================ -->
        <!-- Brush placeholder — reconstruído dinamicamente em C# pelo IniciarAnimacaoGradienteSidebar()
             Qualquer alteração de cores/timing deve ser feita na configuração daquele método -->
        <LinearGradientBrush x:Key="SidebarAnimGradient"
                             StartPoint="0,0.5"
                             EndPoint="1,0.5">
            <GradientStop Offset="0.0" Color="#2D089F"/>
            <GradientStop Offset="1.0" Color="#8E089D"/>
        </LinearGradientBrush>

        <!-- Efeito de Sombra -->
        <DropShadowEffect x:Key="DropShadowEffect" 
                          ShadowDepth="2" 
                          BlurRadius="8" 
                          Opacity="0.5"/>
        
        <!-- ============================================ -->
        <!-- ESTILO GLOBAL DE CHECKBOX CUSTOMIZADA -->
        <!-- ============================================ -->
        <Style x:Key="CustomCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <!-- Box customizada 24x24 -->
                            <Border x:Name="CheckBoxBorder"
                                   Width="24" 
                                   Height="24" 
                                   Background="{DynamicResource BackgroundDark}"
                                   BorderBrush="{StaticResource PrimaryColor}"
                                   BorderThickness="2"
                                   CornerRadius="4"
                                   Margin="0,0,10,0">
                                <!-- Checkmark (✓) -->
                                <TextBlock x:Name="CheckMark"
                                          Text="✓"
                                          Foreground="{StaticResource PrimaryColor}"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                            </Border>
                            <!-- Texto -->
                            <ContentPresenter VerticalAlignment="Center"
                                            RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <!-- Quando marcado -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>
                            <!-- Desabilitado -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ============================================ -->
        <!-- ESTILOS AUXILIARES DO DECODIFICADOR CNAB -->
        <!-- ============================================ -->
        <Style x:Key="CnabRoundedTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#303036"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="#4B3E59"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="SelectionOpacity" Value="0.45"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="OuterBorder" Property="Background" Value="#34343A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="OuterBorder" Property="Background" Value="#35353B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.65"/>
                                <Setter TargetName="OuterBorder" Property="Background" Value="#29292D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CnabActionIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#322540"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#433055"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="CnabTabToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#29292E"/>
            <Setter Property="Foreground" Value="#B9B9C1"/>
            <Setter Property="BorderBrush" Value="#3B3B42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#342244"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ESTILO DO EXPANDER SEM SETA (Legacy) -->
        <!-- ============================================ -->
        <Style x:Key="NoArrowExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}">
                            <StackPanel>
                                <!-- Header clicável -->
                                <ContentPresenter x:Name="HeaderSite"
                                                ContentSource="Header"
                                                Margin="0"
                                                RecognizesAccessKey="True"/>

                                <!-- Conteúdo -->
                                <ContentPresenter x:Name="ExpandSite"
                                                Visibility="Collapsed"
                                                ContentSource="Content"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ESTILO DO EXPANDER LIMPO -->
        <!-- ============================================ -->
        <Style x:Key="CleanExpanderStyle" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->
                                <Border Grid.Row="0" Background="Transparent">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>

                                <!-- CONTENT -->
                                <ContentPresenter x:Name="ContentSite"
                                                Grid.Row="1"
                                                Visibility="Collapsed"
                                                Margin="0"
                                                ContentSource="Content"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- SCROLLBAR MODERNA E MINIMALISTA -->
        <!-- ============================================ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource ScrollbarColor}"
                                                        CornerRadius="4"
                                                        Margin="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ESTILO BASE DOS BOTÕES DA BARRA SUPERIOR -->
        <!-- ============================================ -->
        <Style x:Key="TopBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ESTILO DO BOTÃO FECHAR (VERMELHO) -->
        <!-- ============================================ -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="0,20,0,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CloseButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ESTILO GLOBAL DOS TOGGLEBUTTONS -->
        <!-- ============================================ -->
        <Style x:Key="SidebarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="Margin" Value="4,2,4,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <!-- Ícone via Segoe MDL2 Assets (Tag do botão) -->
                                <TextBlock x:Name="IconText"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <!-- Texto -->
                                <ContentPresenter x:Name="ContentText"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover: cinza com toque de roxo, sutil -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#2D2538"/>
                            </Trigger>
                            <!-- Selecionado: gradiente animado, fundo transparente -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SidebarAnimGradient}"/>
                                <Setter TargetName="RootBorder" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <!-- Selecionado + hover: mantém o toque roxo sutil -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RootBorder" Property="Background" Value="#2D2538"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- ESTILO DO TOGGLE DE FORNECEDOR (LISTA EMAIL) -->
        <!-- ============================================ -->
        <Style x:Key="EmailFornecedorToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#2D2538"/>
                            </Trigger>
                            <!-- Selecionado: preenchimento roxo claro igual à seleção da OPEX -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#4d2266"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RootBorder" Property="Background" Value="#5a2977"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============================================ -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4a0f88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ============================================ -->
    <!-- GRID RAIZ PARA GERENCIAR Z-INDEX -->
    <!-- ============================================ -->
    <Grid>

        <!-- ============================================ -->
        <!-- PROGRAMA COMPLETO -->
        <!-- ============================================ -->
        <Grid x:Name="AppRoot" Opacity="0">

            <Border CornerRadius="20"
                    Background="{DynamicResource BackgroundDark}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/> <!-- Barra superior -->
                        <RowDefinition Height="*"/>  <!-- Conteúdo principal -->
                    </Grid.RowDefinitions>

                    <!-- ============================================ -->
                    <!-- BARRA SUPERIOR -->
                    <!-- ============================================ -->
                    <Border Grid.Row="0"
                            Background="#992A2A2D"
                            Padding="2"
                            CornerRadius="20,20,0,0"
                            MouseLeftButtonDown="TopBar_MouseLeftButtonDown"
                            Panel.ZIndex="100">

                        <Border Background="{DynamicResource BackgroundMedium}"
                                CornerRadius="18,18,0,0">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <!-- Menu Hamburguer -->
                                <Button x:Name="MenuHamburguerButton"
                                       Grid.Column="0"
                                       Width="40"
                                       Height="40"
                                       Background="Transparent"
                                       BorderThickness="0"
                                       Cursor="Hand"
                                       Click="MenuHamburguer_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="HamburgerBorder"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   BorderBrush="Transparent"
                                                   CornerRadius="12">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Rectangle x:Name="Line1" Width="18" Height="2" Fill="White" Margin="0,2" RadiusX="1" RadiusY="1"/>
                                                    <Rectangle x:Name="Line2" Width="18" Height="2" Fill="White" Margin="0,2" RadiusX="1" RadiusY="1"/>
                                                    <Rectangle x:Name="Line3" Width="18" Height="2" Fill="White" Margin="0,2" RadiusX="1" RadiusY="1"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HamburgerBorder" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                                    <Setter TargetName="HamburgerBorder" Property="BorderThickness" Value="1"/>
                                                    <Setter TargetName="Line1" Property="Fill" Value="{StaticResource PrimaryColor}"/>
                                                    <Setter TargetName="Line2" Property="Fill" Value="{StaticResource PrimaryColor}"/>
                                                    <Setter TargetName="Line3" Property="Fill" Value="{StaticResource PrimaryColor}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Popup do Menu -->
                                <Popup x:Name="MenuPopup"
                                      PlacementTarget="{Binding ElementName=MenuHamburguerButton}"
                                      Placement="Bottom"
                                      HorizontalOffset="0"
                                      VerticalOffset="2"
                                      StaysOpen="False"
                                      AllowsTransparency="True"
                                      Opened="MenuPopup_Opened">
                                    <Border x:Name="MenuPopupBorder"
                                           Background="{DynamicResource BackgroundMedium}"
                                           BorderBrush="{StaticResource AccentColor}"
                                           BorderThickness="1"
                                           CornerRadius="0,5,5,5"
                                           Padding="0"
                                           MinWidth="150"
                                           RenderTransformOrigin="0.5,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" 
                                                            Direction="270" 
                                                            ShadowDepth="3" 
                                                            BlurRadius="10" 
                                                            Opacity="0.5"/>
                                        </Border.Effect>
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="PopupScaleTransform" ScaleY="0"/>
                                        </Border.RenderTransform>
                                        <StackPanel>
                                            <Button Content="Opções"
                                                   Background="Transparent"
                                                   Foreground="{DynamicResource TextColor}"
                                                   BorderThickness="0"
                                                   Padding="15,10"
                                                   Cursor="Hand"
                                                   Click="OpcoesMenu_Click"
                                                   HorizontalContentAlignment="Left"
                                                   FontSize="13"
                                                   Margin="5">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                           CornerRadius="3"
                                                                           Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
<Button Content="Infos Positiva"
                                                   Background="Transparent"
                                                   Foreground="{DynamicResource TextColor}"
                                                   BorderThickness="0"
                                                   Padding="15,10"
                                                   Cursor="Hand"
                                                   Click="InfosPositivaMenu_Click"
                                                   HorizontalContentAlignment="Left"
                                                   FontSize="13"
                                                   Margin="5">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                           CornerRadius="3"
                                                                           Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
<Button Content="Sobre"
                                                   Background="Transparent"
                                                   Foreground="{DynamicResource TextColor}"
                                                   BorderThickness="0"
                                                   Padding="15,10"
                                                   Cursor="Hand"
                                                   Click="SobreMenu_Click"
                                                   HorizontalContentAlignment="Left"
                                                   FontSize="13"
                                                   Margin="5">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                           CornerRadius="3"
                                                                           Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Título -->
                                <TextBlock Text="Hub Financeiro"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Margin="15,0,0,0"
                                           Foreground="{DynamicResource TextColor}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <!-- Botões de Controle -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Grid.Column="2">

                                    <Button Content="─"
                                            Width="40"
                                            Style="{StaticResource TopBarButtonStyle}"
                                            Click="Minimize_Click"
                                            ToolTip="Minimizar"/>

                                    <Button Content="☐"
                                            Width="40"
                                            Style="{StaticResource TopBarButtonStyle}"
                                            Click="Maximize_Click"
                                            ToolTip="Maximizar"/>

                                    <Button Content="✕"
                                            Width="40"
                                            Style="{StaticResource CloseButtonStyle}"
                                            Click="Close_Click"
                                            ToolTip="Fechar"/>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- ============================================ -->
                    <!-- ÁREA PRINCIPAL (COM BARRA LATERAL) -->
                    <!-- ============================================ -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SidebarColumn" Width="190"/> <!-- Barra lateral - largura controlada por código -->
                            <ColumnDefinition Width="*"/>   <!-- Área de execução -->
                        </Grid.ColumnDefinitions>

                        <!-- ============================================ -->
                        <!-- BARRA LATERAL COLAPSÁVEL -->
                        <!-- ============================================ -->
                        <Border Grid.Column="0" 
                                Background="{DynamicResource BackgroundMedium}" 
                                CornerRadius="0,0,0,20"
                                ClipToBounds="True">
                            <StackPanel x:Name="SidebarPanel" Margin="0,6,0,0">

                                    <!-- Botão colapsar: integrado como primeiro item do menu -->
                                    <Button x:Name="SidebarCollapseButton"
                                            HorizontalAlignment="Stretch"
                                            Margin="4,2,4,4"
                                            Height="36"
                                            Cursor="Hand"
                                            Click="SidebarCollapse_Click"
                                            ToolTip="Recolher menu">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CollapseBorder"
                                                        Background="Transparent"
                                                        CornerRadius="8"
                                                        Padding="10,0">
                                                    <TextBlock x:Name="CollapseArrow"
                                                               Text="«"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               Foreground="#666666"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CollapseBorder" Property="Background" Value="#2D2538"/>
                                                        <Setter TargetName="CollapseArrow" Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Home -->
                                    <ToggleButton x:Name="SidebarHomeButton"
                                                Content="Home"
                                                Tag="&#xE80F;"
                                                Style="{StaticResource SidebarToggleButtonStyle}"
                                                Click="SidebarButton_Click"/>

                                    <ToggleButton Content="Envio de E-mails" 
                                                Tag="&#xE715;"
                                                Style="{StaticResource SidebarToggleButtonStyle}" 
                                                Click="SidebarButton_Click"/>
                                    
                                    <ToggleButton Content="Fornecedores" 
                                                Tag="&#xE77B;"
                                                Style="{StaticResource SidebarToggleButtonStyle}" 
                                                Click="SidebarButton_Click"/>
                                    
                                    <ToggleButton Content="O.P.E.X" 
                                                Tag="&#xE8C7;"
                                                Style="{StaticResource SidebarToggleButtonStyle}" 
                                                Click="SidebarButton_Click"/>
                                    
                                    <ToggleButton Content="Calc subconjunto" 
                                                Tag="&#xE8EF;"
                                                Style="{StaticResource SidebarToggleButtonStyle}" 
                                                Click="SidebarButton_Click"/>
                                    
                                    <ToggleButton Content="Compara valores" 
                                                Tag="&#xE762;"
                                                Style="{StaticResource SidebarToggleButtonStyle}" 
                                                Click="SidebarButton_Click"/>

                                    <ToggleButton Content="Decodificador CNAB"
                                                Tag="&#xE943;"
                                                Style="{StaticResource SidebarToggleButtonStyle}"
                                                Click="SidebarButton_Click"/>

                                    <ToggleButton Content="Analise de Faturas"
                                                Tag="&#xE9F9;"
                                                Style="{StaticResource SidebarToggleButtonStyle}"
                                                Click="SidebarButton_Click"/>
                                    <ToggleButton Content="Aux Conciliação"
                                                  Tag="&#xE9D2;"
                                                  Style="{StaticResource SidebarToggleButtonStyle}"
                                                  Click="SidebarButton_Click"/>
                                </StackPanel>
                        </Border>

                        <!-- ============================================ -->
                        <!-- ÁREA DE EXECUÇÃO -->
                        <!-- ============================================ -->
                        <Border Grid.Column="1" 
                                Background="{DynamicResource BackgroundDark}" 
                                CornerRadius="0,0,20,0">
                            <Grid x:Name="ExecutionArea">
                                
                                <!-- Logo Central (carregada via CarregarLogo() no construtor) -->
                                <Image x:Name="LogoExecutionArea"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Width="300"
                                       Height="300"
                                       Stretch="Uniform"
                                       Margin="0,-110,0,0">
                                       
                                    <Image.Effect>
                                        <BlurEffect x:Name="LogoBlur" Radius="0"/>
                                    </Image.Effect>
                                </Image>

                                <!-- ============================================ -->
                                <!-- LAYOUT ENVIO DE E-MAILS -->
                                <!-- ============================================ -->
                                <Grid x:Name="EmailLayoutGrid" 
                                      Opacity="0" 
                                      Visibility="Collapsed" 
                                      Margin="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/> <!-- Lista de fornecedores -->
                                        <ColumnDefinition Width="3*"/> <!-- Painel de configuração -->
                                    </Grid.ColumnDefinitions>

                                    <!-- ============================================ -->
                                    <!-- LISTBOX DE FORNECEDORES -->
                                    <!-- ============================================ -->
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource BackgroundMedium}"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource AccentColor}"
                                            BorderThickness="1"
                                            Padding="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Título da Lista -->
                                            <TextBlock Text="Fornecedores"
                                                      Grid.Row="0"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontSize="14"
                                                      FontWeight="Bold"
                                                      Margin="10,5,10,10"/>

                                            <!-- Lista com Scroll -->
                                            <ScrollViewer Grid.Row="1"
                                                         VerticalScrollBarVisibility="Auto" 
                                                         Padding="0,0,6,0">
                                                <ItemsControl x:Name="FornecedorItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ToggleButton Content="{Binding Nome}" 
                                                                        Style="{StaticResource EmailFornecedorToggleStyle}" 
                                                                        Margin="0,5,0,0"
                                                                        Click="FornecedorToggle_Click"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <!-- ============================================ -->
                                    <!-- PAINEL DE CONFIGURAÇÃO -->
                                    <!-- ============================================ -->
                                    <Grid Grid.Column="1" Margin="15,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>     <!-- Conteúdo variável -->
                                            <RowDefinition Height="Auto"/>  <!-- Botão fixo -->
                                        </Grid.RowDefinitions>

                                        <!-- ============================================ -->
                                        <!-- CONTEÚDO (ROW 0) -->
                                        <!-- ============================================ -->
                                        <StackPanel Grid.Row="0">

                                            <!-- Dropdown de Layout -->
                                            <Border Background="{DynamicResource BackgroundMedium}"
                                                    CornerRadius="6"
                                                    Padding="0"
                                                    Margin="0,0,0,10"
                                                    Width="300"
                                                    HorizontalAlignment="Left">

                                                <Expander x:Name="LayoutExpander"
                                                          Style="{StaticResource CleanExpanderStyle}"
                                                          Background="Transparent"
                                                          Expanded="LayoutExpander_Expanded"
                                                          Collapsed="LayoutExpander_Collapsed">

                                                    <!-- CABEÇALHO -->
                                                    <Expander.Header>
                                                        <Border Padding="12"
                                                                Background="Transparent"
                                                                MouseLeftButtonDown="LayoutHeader_Click">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition/>
                                                                    <ColumnDefinition Width="20"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock x:Name="LayoutHeaderText"
                                                                          Text="Layout"
                                                                          Foreground="{DynamicResource TextColor}"
                                                                          FontWeight="SemiBold"
                                                                          VerticalAlignment="Center"/>

                                                                <!-- SETA ANIMADA -->
                                                                <TextBlock x:Name="ArrowIcon"
                                                                          Grid.Column="1"
                                                                          Text="›"
                                                                          FontSize="16"
                                                                          Foreground="{DynamicResource TextColor}"
                                                                          HorizontalAlignment="Right"
                                                                          VerticalAlignment="Center"
                                                                          RenderTransformOrigin="0.5,0.5">
                                                                    <TextBlock.RenderTransform>
                                                                        <RotateTransform Angle="0"/>
                                                                    </TextBlock.RenderTransform>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                    </Expander.Header>

                                                    <!-- ITENS DO DROPDOWN -->
                                                    <StackPanel Margin="12,0,12,12">
                                                        <TextBlock Text="Cobrança de nota de comissões"
                                                                  Foreground="{DynamicResource TextColor}"
                                                                  Cursor="Hand"
                                                                  Padding="8"
                                                                  MouseEnter="LayoutItem_MouseEnter"
                                                                  MouseLeave="LayoutItem_MouseLeave"
                                                                  MouseLeftButtonDown="LayoutItem_Click">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#2A2A2D"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Expander>
                                            </Border>

                                            <!-- ============================================ -->
                                            <!-- PAINEL DE DATA (OPCIONAL) -->
                                            <!-- ============================================ -->
                                            <StackPanel x:Name="DataPanel"
                                                        Margin="0,15,0,0"
                                                        Visibility="Collapsed">

                                                <TextBlock Text="Selecione a data do extrato:" 
                                                          Foreground="{DynamicResource TextColor}" 
                                                          FontWeight="SemiBold" 
                                                          Margin="0,0,0,8"
                                                          HorizontalAlignment="Left"/>

                                                <DatePicker x:Name="ExtratoDatePicker" 
                                                           Width="200" 
                                                           Background="{DynamicResource BackgroundMedium}" 
                                                           Foreground="{DynamicResource TextColor}" 
                                                           BorderBrush="{StaticResource AccentColor}" 
                                                           BorderThickness="1"
                                                           HorizontalAlignment="Left"/>
                                            </StackPanel>

                                        </StackPanel>

                                        <!-- ============================================ -->
                                        <!-- BOTÃO FIXO (ROW 1) -->
                                        <!-- ============================================ -->
                                        <Button x:Name="EnviarEmailsButton" 
                                                Grid.Row="1"
                                                Content="Enviar E-mails" 
                                                Width="150" 
                                                Height="35"
                                                Margin="0,20,0,10"
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Bottom"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="EnviarEmailsButton_Click"/>

                                    </Grid>

                                </Grid>
                                
                                <!-- ============================================ -->
                                <!-- LAYOUT FORNECEDORES -->
                                <!-- ============================================ -->
                                <Grid x:Name="FornecedoresLayoutGrid" 
                                      Opacity="0" 
                                      Visibility="Collapsed" 
                                      Margin="20"
                                      Focusable="True"
                                      KeyDown="FornecedoresLayoutGrid_KeyDown">
                                    
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="350"/> <!-- Lista de fornecedores -->
                                        <ColumnDefinition Width="*"/>   <!-- Área para futuras funcionalidades -->
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Lista de Fornecedores à Esquerda -->
                                    <Border Grid.Column="0"
                                            Background="#99252526"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource AccentColor}"
                                            BorderThickness="1"
                                            Padding="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- Título da Lista -->
                                            <TextBlock Text="Fornecedores"
                                                      Grid.Row="0"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontSize="14"
                                                      FontWeight="Bold"
                                                      Margin="10,5,10,10"/>

                                            <!-- Barra de Pesquisa -->
                                            <Border Grid.Row="1"
                                                    Background="#992A2A2D"
                                                    BorderBrush="{StaticResource AccentColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="20"
                                                    Margin="5,0,5,10"
                                                    Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Ícone de Lupa -->
                                                    <TextBlock Grid.Column="0"
                                                              Text="🔍"
                                                              FontSize="16"
                                                              Foreground="#999999"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,8,0"/>
                                                    
                                                    <!-- Campo de Pesquisa -->
                                                    <TextBox x:Name="PesquisaFornecedorTextBox"
                                                            Grid.Column="1"
                                                            Background="Transparent"
                                                            Foreground="{DynamicResource TextColor}"
                                                            BorderThickness="0"
                                                            FontSize="13"
                                                            VerticalAlignment="Center"
                                                            CaretBrush="{DynamicResource TextColor}"
                                                            TextChanged="PesquisaFornecedorTextBox_TextChanged">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="TextBox">
                                                                            <Grid>
                                                                                <!-- Placeholder "Pesquisar" -->
                                                                                <TextBlock x:Name="PlaceholderText"
                                                                                          Text="Pesquisar"
                                                                                          Foreground="#666666"
                                                                                          FontSize="13"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="2,0,0,0"
                                                                                          IsHitTestVisible="False">
                                                                                    <TextBlock.Style>
                                                                                        <Style TargetType="TextBlock">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </TextBlock.Style>
                                                                                </TextBlock>
                                                                                
                                                                                <!-- TextBox Real -->
                                                                                <ScrollViewer x:Name="PART_ContentHost"
                                                                                            VerticalAlignment="Center"
                                                                                            Margin="0"/>
                                                                            </Grid>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>
                                            </Border>

                                            <!-- Lista com Scroll - Altura completa -->
                                            <ScrollViewer Grid.Row="2"
                                                         VerticalScrollBarVisibility="Auto" 
                                                         Padding="0,0,6,0">
                                                <ItemsControl x:Name="FornecedoresItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="FornecedorBorder"
                                                                    Background="#992A2A2D"
                                                                    CornerRadius="5"
                                                                    Margin="0,5,0,5"
                                                                    Padding="12,8"
                                                                    BorderBrush="{StaticResource AccentColor}"
                                                                    BorderThickness="1"
                                                                    Cursor="Hand"
                                                                    MouseLeftButtonDown="FornecedorItem_Click">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    
                                                                    <!-- Informações do Fornecedor -->
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Nome}" 
                                                                                  Foreground="{DynamicResource TextColor}"
                                                                                  FontWeight="SemiBold"
                                                                                  FontSize="14"/>
                                                                        <TextBlock Text="{Binding Email}" 
                                                                                  Foreground="#999999"
                                                                                  FontSize="12"
                                                                                  Margin="0,2,0,0"/>
                                                                        
                                                                        <!-- Badges de Empresa -->
                                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                                            <!-- Badge Administradora -->
                                                                            <Border CornerRadius="3"
                                                                                   Padding="5,2"
                                                                                   Margin="0,0,5,0"
                                                                                   Background="#1E88E5">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Administradora}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="ADM" 
                                                                                          Foreground="White"
                                                                                          FontSize="10"
                                                                                          FontWeight="Bold"/>
                                                                            </Border>
                                                                            
                                                                            <!-- Badge Corretora -->
                                                                            <Border CornerRadius="3"
                                                                                   Padding="5,2"
                                                                                   Background="#43A047">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Corretora}" Value="True">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <TextBlock Text="COR" 
                                                                                          Foreground="White"
                                                                                          FontSize="10"
                                                                                          FontWeight="Bold"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    
                                                                    <!-- Badge Ativo/Inativo -->
                                                                    <Border Grid.Column="1"
                                                                            CornerRadius="3"
                                                                            Padding="6,3"
                                                                            VerticalAlignment="Top">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                                                        <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                                                        <Setter Property="Background" Value="#666666"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Foreground="{DynamicResource TextColor}"
                                                                                  FontSize="11"
                                                                                  FontWeight="SemiBold">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                                                            <Setter Property="Text" Value="Ativo"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                                                            <Setter Property="Text" Value="Inativo"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Painel de Edição à Direita -->
                                    <Border Grid.Column="1"
                                            Background="#99252526"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource AccentColor}"
                                            BorderThickness="1"
                                            Padding="20"
                                            Margin="15,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Campos de Edição -->
                                            <StackPanel Grid.Row="0" VerticalAlignment="Top">
                                            
                                            <!-- Título -->
                                            <TextBlock x:Name="FornInfoTitle"
                                                      Text="Informações do Fornecedor"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontSize="13"
                                                      FontWeight="Bold"
                                                      Margin="0,0,0,14"/>

                                            <!-- Campo Nome -->
                                            <TextBlock Text="Nome:"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,5"/>
                                            <TextBox x:Name="FornecedorNomeTextBox"
                                                    Background="#992A2A2D"
                                                    Foreground="{DynamicResource TextColor}"
                                                    BorderBrush="{StaticResource AccentColor}"
                                                    BorderThickness="1"
                                                    Padding="8,6"
                                                    FontSize="12"
                                                    Margin="0,0,0,10"
                                                    CaretBrush="{DynamicResource TextColor}"
                                                    TextChanged="FornecedorNomeTextBox_TextChanged">
                                                <TextBox.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="5"/>
                                                    </Style>
                                                </TextBox.Resources>
                                            </TextBox>

                                            <!-- Campo Código -->
                                            <TextBlock Text="Código:"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,5"/>
                                            <TextBox x:Name="FornecedorCodigoTextBox"
                                                    Background="#992A2A2D"
                                                    Foreground="{DynamicResource TextColor}"
                                                    BorderBrush="{StaticResource AccentColor}"
                                                    BorderThickness="1"
                                                    Padding="8,6"
                                                    FontSize="12"
                                                    Margin="0,0,0,10"
                                                    CaretBrush="{DynamicResource TextColor}"
                                                    TextChanged="FornecedorCodigoTextBox_TextChanged"
                                                    PreviewTextInput="NumericTextBox_PreviewTextInput">
                                                <TextBox.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="5"/>
                                                    </Style>
                                                </TextBox.Resources>
                                            </TextBox>

                                            <!-- Campo Natureza -->
                                            <TextBlock Text="Natureza:"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,5"/>
                                            <TextBox x:Name="FornecedorNaturezaTextBox"
                                                    Background="#992A2A2D"
                                                    Foreground="{DynamicResource TextColor}"
                                                    BorderBrush="{StaticResource AccentColor}"
                                                    BorderThickness="1"
                                                    Padding="8,6"
                                                    FontSize="12"
                                                    Margin="0,0,0,10"
                                                    CaretBrush="{DynamicResource TextColor}"
                                                    PreviewTextInput="NumericTextBox_PreviewTextInput">
                                                <TextBox.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="5"/>
                                                    </Style>
                                                </TextBox.Resources>
                                            </TextBox>

                                            <!-- Campo Email -->
                                            <TextBlock Text="E-mail:"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,5"/>
                                            <TextBox x:Name="FornecedorEmailTextBox"
                                                    Background="#992A2A2D"
                                                    Foreground="{DynamicResource TextColor}"
                                                    BorderBrush="{StaticResource AccentColor}"
                                                    BorderThickness="1"
                                                    Padding="8,6"
                                                    FontSize="12"
                                                    Margin="0,0,0,10"
                                                    CaretBrush="{DynamicResource TextColor}">
                                                <TextBox.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="5"/>
                                                    </Style>
                                                </TextBox.Resources>
                                            </TextBox>

                                            <!-- Campos Dia de Pagamento e Tipo de Pagamento lado a lado -->
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Label Dia de Pagamento -->
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                          Text="Dia de Pagamento (1-31):"
                                                          Foreground="{DynamicResource TextColor}"
                                                          FontWeight="SemiBold"
                                                          Margin="0,0,0,5"/>

                                                <!-- Label Tipo de Pagamento -->
                                                <TextBlock Grid.Row="0" Grid.Column="2"
                                                          Text="Tipo de Pagamento (01-03):"
                                                          Foreground="{DynamicResource TextColor}"
                                                          FontWeight="SemiBold"
                                                          Margin="0,0,0,5"/>

                                                <!-- TextBox Dia de Pagamento -->
                                                <TextBox x:Name="FornecedorDiaPagamentoTextBox"
                                                        Grid.Row="1" Grid.Column="0"
                                                        Background="#992A2A2D"
                                                        Foreground="{DynamicResource TextColor}"
                                                        BorderBrush="{StaticResource AccentColor}"
                                                        BorderThickness="1"
                                                        Padding="8,6"
                                                        FontSize="12"
                                                        Width="80"
                                                        HorizontalAlignment="Left"
                                                        CaretBrush="{DynamicResource TextColor}"
                                                        MaxLength="2"
                                                        PreviewTextInput="NumericTextBox_PreviewTextInput">
                                                    <TextBox.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="5"/>
                                                        </Style>
                                                    </TextBox.Resources>
                                                </TextBox>

                                                <!-- TextBox Tipo de Pagamento -->
                                                <TextBox x:Name="FornecedorTipoPagamentoTextBox"
                                                        Grid.Row="1" Grid.Column="2"
                                                        Background="#992A2A2D"
                                                        Foreground="{DynamicResource TextColor}"
                                                        BorderBrush="{StaticResource AccentColor}"
                                                        BorderThickness="1"
                                                        Padding="8,6"
                                                        FontSize="12"
                                                        Width="80"
                                                        HorizontalAlignment="Left"
                                                        CaretBrush="{DynamicResource TextColor}"
                                                        MaxLength="2"
                                                        PreviewTextInput="NumericTextBox_PreviewTextInput">
                                                    <TextBox.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="5"/>
                                                        </Style>
                                                    </TextBox.Resources>
                                                </TextBox>
                                            </Grid>

                                            <!-- CheckBoxes Personalizadas -->
                                            <TextBlock Text="Configurações:"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="SemiBold"
                                                      Margin="0,6,0,8"/>
                                            
                                            <Grid Margin="0,0,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- CheckBox Administradora -->
                                                <Border Grid.Row="0" Grid.Column="0"
                                                        Background="#992A2A2D"
                                                        BorderBrush="{StaticResource AccentColor}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="10"
                                                        Margin="0,0,5,10"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="AdministradoraBox_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <Border x:Name="AdministradoraCheckMark"
                                                               Grid.Column="0"
                                                               Width="24"
                                                               Height="24"
                                                               Background="{DynamicResource BackgroundDark}"
                                                               BorderBrush="{StaticResource AccentColor}"
                                                               BorderThickness="2"
                                                               CornerRadius="4"
                                                               Margin="0,0,10,0">
                                                            <TextBlock x:Name="AdministradoraCheck"
                                                                      Text="✓"
                                                                      Foreground="{StaticResource PrimaryColor}"
                                                                      FontSize="16"
                                                                      FontWeight="Bold"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Visibility="Collapsed"/>
                                                        </Border>
                                                        
                                                        <TextBlock Grid.Column="1"
                                                                  Text="Administradora"
                                                                  Foreground="{DynamicResource TextColor}"
                                                                  FontSize="12"
                                                                  FontWeight="SemiBold"
                                                                  VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                
                                                <!-- CheckBox Corretora -->
                                                <Border Grid.Row="0" Grid.Column="1"
                                                        Background="#992A2A2D"
                                                        BorderBrush="{StaticResource AccentColor}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="10"
                                                        Margin="5,0,0,10"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="CorretoraBox_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <Border x:Name="CorretoraCheckMark"
                                                               Grid.Column="0"
                                                               Width="24"
                                                               Height="24"
                                                               Background="{DynamicResource BackgroundDark}"
                                                               BorderBrush="{StaticResource AccentColor}"
                                                               BorderThickness="2"
                                                               CornerRadius="4"
                                                               Margin="0,0,10,0">
                                                            <TextBlock x:Name="CorretoraCheck"
                                                                      Text="✓"
                                                                      Foreground="{StaticResource PrimaryColor}"
                                                                      FontSize="16"
                                                                      FontWeight="Bold"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Visibility="Collapsed"/>
                                                        </Border>
                                                        
                                                        <TextBlock Grid.Column="1"
                                                                  Text="Corretora"
                                                                  Foreground="{DynamicResource TextColor}"
                                                                  FontSize="12"
                                                                  FontWeight="SemiBold"
                                                                  VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                
                                                <!-- CheckBox Ativo -->
                                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                        Background="#992A2A2D"
                                                        BorderBrush="{StaticResource AccentColor}"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="10"
                                                        Margin="0,0,0,0"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="AtivoBox_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <Border x:Name="AtivoCheckMark"
                                                               Grid.Column="0"
                                                               Width="24"
                                                               Height="24"
                                                               Background="{DynamicResource BackgroundDark}"
                                                               BorderBrush="{StaticResource AccentColor}"
                                                               BorderThickness="2"
                                                               CornerRadius="4"
                                                               Margin="0,0,10,0">
                                                            <TextBlock x:Name="AtivoCheck"
                                                                      Text="✓"
                                                                      Foreground="{StaticResource PrimaryColor}"
                                                                      FontSize="16"
                                                                      FontWeight="Bold"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Visibility="Visible"/>
                                                        </Border>
                                                        
                                                        <TextBlock Grid.Column="1"
                                                                  Text="Fornecedor Ativo"
                                                                  Foreground="{DynamicResource TextColor}"
                                                                  FontSize="12"
                                                                  FontWeight="SemiBold"
                                                                  VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                        </StackPanel>
                                        
                                        <!-- Botão Cadastrar/Atualizar -->
                                        <Button x:Name="BtnCadastrarFornecedor"
                                                Grid.Row="1"
                                                Content="Cadastrar Fornecedor"
                                                Width="150"
                                                Height="32"
                                                HorizontalAlignment="Right"
                                                Margin="0,15,0,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Click="BtnCadastrarFornecedor_Click"
                                                IsEnabled="False"
                                                Opacity="0.4"/>
                                        
                                        </Grid>
                                    </Border>
                                </Grid>

                            <!-- ============================================ -->
                            <!-- LAYOUT HOME (TELA INICIAL) -->
                            <!-- ============================================ -->
                            <Grid x:Name="HomeLayoutGrid"
                                  Opacity="1"
                                  Visibility="Visible"
                                  Margin="40">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,0,200">
                                    <TextBlock Text="Hub Financeiro"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextColor}"
                                               HorizontalAlignment="Center"
                                               Opacity="0.5"/>
                                    <TextBlock Text="Selecione uma opção no menu lateral"
                                               FontSize="13"
                                               Foreground="#666666"
                                               HorizontalAlignment="Center"
                                               Margin="0,10,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ============================================ -->
                            <!-- LAYOUT CALC SUBCONJUNTO -->
                            <!-- ============================================ -->
                            <Grid x:Name="CalcSubconjuntoLayout" 
                                  Opacity="0"
                                  Visibility="Collapsed"
                                  Margin="40">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0"
                                          Text="Calculadora de Subconjunto"
                                          FontSize="28"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource TextColor}"/>
                                
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Button Grid.Column="0"
                                           VerticalAlignment="Top"
                                           Height="25"
                                           Background="{StaticResource PrimaryColor}"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Cursor="Hand"
                                           Click="AdicionarValor_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="8"
                                                                   Padding="15,0">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#9140f0"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+ " FontSize="20" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Adicionar Valor" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0"
                                               Background="#1A1A1A"
                                               CornerRadius="8"
                                               BorderBrush="{StaticResource PrimaryColor}"
                                               BorderThickness="1">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                         Margin="10">
                                                <ItemsControl x:Name="Conjunto1ItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="6"
                                                                   Padding="15,2"
                                                                   Margin="0,0,0,2"
                                                                   Cursor="Hand"
                                                                   MouseLeftButtonDown="ItemConjunto_MouseLeftButtonDown"
                                                                   Tag="{Binding}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource BackgroundMedium}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Destacado}" Value="True">
                                                                                <Setter Property="Background" Value="#7C3AED"/>
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="14"
                                                                          FontWeight="SemiBold"
                                                                          Foreground="{DynamicResource TextColor}"
                                                                          HorizontalAlignment="Center">
                                                                    <Run Text="R$ "/>
                                                                    <Run Text="{Binding Valor, StringFormat=N2}"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                        
                                        <Border Grid.Column="2"
                                               Background="#1A1A1A"
                                               CornerRadius="8"
                                               BorderBrush="{StaticResource PrimaryColor}"
                                               BorderThickness="1">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                         Margin="10">
                                                <ItemsControl x:Name="Conjunto2ItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="6"
                                                                   Padding="15,2"
                                                                   Margin="0,0,0,2"
                                                                   Cursor="Hand"
                                                                   MouseLeftButtonDown="ItemConjunto_MouseLeftButtonDown"
                                                                   Tag="{Binding}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource BackgroundMedium}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Destacado}" Value="True">
                                                                                <Setter Property="Background" Value="#7C3AED"/>
                                                                            </DataTrigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="14"
                                                                          FontWeight="SemiBold"
                                                                          Foreground="{DynamicResource TextColor}"
                                                                          HorizontalAlignment="Center">
                                                                    <Run Text="R$ "/>
                                                                    <Run Text="{Binding Valor, StringFormat=N2}"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                    
                                    <StackPanel Grid.Column="4"
                                               VerticalAlignment="Top">
                                        
                                        <Border Background="{DynamicResource BackgroundMedium}"
                                               CornerRadius="6"
                                               Height="45"
                                               Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0"
                                                          Text="R$"
                                                          Foreground="{DynamicResource TextColor}"
                                                          FontWeight="Bold"
                                                          FontSize="14"
                                                          Margin="12,0,5,0"
                                                          VerticalAlignment="Center"/>
                                                
                                                <TextBox x:Name="ValorObjetivoTextBox"
                                                        Grid.Column="1"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource TextColor}"
                                                        BorderThickness="0"
                                                        Padding="0,0,12,0"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        VerticalContentAlignment="Center"
                                                        CaretBrush="{StaticResource PrimaryColor}"
                                                        TextChanged="ValorObjetivoTextBox_TextChanged">
                                                    <TextBox.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="0"/>
                                                        </Style>
                                                    </TextBox.Resources>
                                                </TextBox>
                                                
                                                <TextBlock x:Name="ValorObjetivoPlaceholder"
                                                          Grid.Column="1"
                                                          Text="Valor Objetivo"
                                                          Foreground="#666666"
                                                          FontWeight="SemiBold"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False"
                                                          Visibility="Visible"/>
                                            </Grid>
                                        </Border>
                                        
                                        <Border Background="{DynamicResource BackgroundMedium}"
                                               CornerRadius="6"
                                               Height="45"
                                               Margin="0,0,0,15">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Grid.Column="0"
                                                          Text="R$"
                                                          Foreground="{DynamicResource TextColor}"
                                                          FontWeight="Bold"
                                                          FontSize="14"
                                                          Margin="12,0,5,0"
                                                          VerticalAlignment="Center"/>
                                                
                                                <TextBox x:Name="MargemTextBox"
                                                        Grid.Column="1"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource TextColor}"
                                                        BorderThickness="0"
                                                        Padding="0,0,12,0"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        VerticalContentAlignment="Center"
                                                        CaretBrush="{StaticResource PrimaryColor}"
                                                        TextChanged="MargemTextBox_TextChanged">
                                                    <TextBox.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="0"/>
                                                        </Style>
                                                    </TextBox.Resources>
                                                </TextBox>
                                                
                                                <TextBlock x:Name="MargemPlaceholder"
                                                          Grid.Column="1"
                                                          Text="Margem"
                                                          Foreground="#666666"
                                                          FontWeight="SemiBold"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False"
                                                          Visibility="Visible"/>
                                            </Grid>
                                        </Border>
                                        
                                        <Button Height="50"
                                               Background="{StaticResource PrimaryColor}"
                                               Foreground="White"
                                               BorderThickness="0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Cursor="Hand"
                                               Margin="0,150,0,0"
                                               Click="Calcular_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                       CornerRadius="8">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#9140f0"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="≡ " FontSize="20" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="CALCULAR" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        
                                    </StackPanel>
                                    
                                </Grid>
                            </Grid>
                                
                            <!-- ============================================ -->
                            <!-- LAYOUT COMPARA VALORES -->
                            <!-- ============================================ -->
                            <Grid x:Name="CompararValoresLayout"
                                  Opacity="0"
                                  Visibility="Collapsed"
                                  Margin="40">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="20"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Título -->
                                <TextBlock Grid.Row="0"
                                          Text="Compara valores"
                                          FontSize="28"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource TextColor}"/>

                                <!-- Grid principal: headers + listas + botões alinhados -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>  <!-- Botão esq -->
                                        <ColumnDefinition Width="*"/>     <!-- Lista 1 -->
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>     <!-- Divergências -->
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>     <!-- Lista 2 -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Botão dir -->
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>  <!-- Headers -->
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="*"/>     <!-- Conteúdo -->
                                    </Grid.RowDefinitions>

                                    <!-- Headers alinhados com suas listas -->

                                    <!-- Label editável: Conjunto 1 -->
                                    <Grid Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="LabelConjunto1"
                                                  Text="Conjunto 1"
                                                  Foreground="{DynamicResource TextColor}"
                                                  FontSize="15"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"
                                                  Cursor="IBeam"
                                                  MouseLeftButtonDown="LabelConjunto1_MouseLeftButtonDown"
                                                  Visibility="Visible"/>
                                        <TextBox x:Name="EditConjunto1"
                                                Text="Conjunto 1"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextColor}"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource PrimaryColor}"
                                                BorderThickness="0,0,0,1"
                                                CaretBrush="{StaticResource PrimaryColor}"
                                                TextAlignment="Center"
                                                MinWidth="100"
                                                Visibility="Collapsed"
                                                LostFocus="EditConjunto1_LostFocus"
                                                KeyDown="EditConjunto_KeyDown">
                                            <TextBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="0"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </Grid>

                                    <!-- Label Divergências (não editável) -->
                                    <TextBlock Grid.Row="0" Grid.Column="3"
                                              Text="Divergências"
                                              Foreground="{DynamicResource TextColor}"
                                              FontSize="15"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"/>

                                    <!-- Label editável: Conjunto 2 -->
                                    <Grid Grid.Row="0" Grid.Column="5" HorizontalAlignment="Center">
                                        <TextBlock x:Name="LabelConjunto2"
                                                  Text="Conjunto 2"
                                                  Foreground="{DynamicResource TextColor}"
                                                  FontSize="15"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"
                                                  Cursor="IBeam"
                                                  MouseLeftButtonDown="LabelConjunto2_MouseLeftButtonDown"
                                                  Visibility="Visible"/>
                                        <TextBox x:Name="EditConjunto2"
                                                Text="Conjunto 2"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextColor}"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource PrimaryColor}"
                                                BorderThickness="0,0,0,1"
                                                CaretBrush="{StaticResource PrimaryColor}"
                                                TextAlignment="Center"
                                                MinWidth="100"
                                                Visibility="Collapsed"
                                                LostFocus="EditConjunto2_LostFocus"
                                                KeyDown="EditConjunto_KeyDown">
                                            <TextBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="0"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </Grid>

                                    <!-- Botão Adicionar Conjunto 1 (esquerda da lista) -->
                                    <Button Grid.Row="2" Grid.Column="0"
                                           VerticalAlignment="Top"
                                           Height="32"
                                           Margin="0,0,10,0"
                                           Background="{StaticResource PrimaryColor}"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Cursor="Hand"
                                           Click="AdicionarValorConjunto1_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="8"
                                                                   Padding="12,0">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#9140f0"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+ " FontSize="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="Adicionar Valor" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Lista Conjunto 1 -->
                                    <Border Grid.Row="2" Grid.Column="1"
                                           Background="#1A1A1A"
                                           CornerRadius="8"
                                           BorderBrush="{StaticResource PrimaryColor}"
                                           BorderThickness="1">
                                        <ScrollViewer x:Name="ScrollC1" VerticalScrollBarVisibility="Auto" Margin="10" ScrollChanged="CompararScroll_Changed">
                                            <ItemsControl x:Name="CompararConjunto1ItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="6"
                                                               Height="36"
                                                               Margin="0,0,0,3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource BackgroundMedium}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsVazio}" Value="True">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="14"
                                                                      FontWeight="SemiBold"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsVazio}" Value="True">
                                                                                <Setter Property="Foreground" Value="#444444"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Text="R$ "/>
                                                                <Run Text="{Binding ValorTexto, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Lista Divergências (centro) -->
                                    <Border Grid.Row="2" Grid.Column="3"
                                           Background="#1A1A1A"
                                           CornerRadius="8"
                                           BorderBrush="{StaticResource PrimaryColor}"
                                           BorderThickness="1">
                                        <ScrollViewer x:Name="ScrollDiv" VerticalScrollBarVisibility="Auto" Margin="10" ScrollChanged="CompararScroll_Changed">
                                            <ItemsControl x:Name="CompararDivergenciasItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="6"
                                                               Height="36"
                                                               Margin="0,0,0,3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource BackgroundMedium}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFaltanteNoC1}" Value="True">
                                                                            <Setter Property="Background" Value="#1A3F6B"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsFaltanteNoC2}" Value="True">
                                                                            <Setter Property="Background" Value="#6B1A1A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Texto}"
                                                                      FontSize="13"
                                                                      FontWeight="SemiBold"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#555555"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFaltanteNoC1}" Value="True">
                                                                                <Setter Property="Foreground" Value="#6BB5FF"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsFaltanteNoC2}" Value="True">
                                                                                <Setter Property="Foreground" Value="#FF8080"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Lista Conjunto 2 -->
                                    <Border Grid.Row="2" Grid.Column="5"
                                           Background="#1A1A1A"
                                           CornerRadius="8"
                                           BorderBrush="{StaticResource PrimaryColor}"
                                           BorderThickness="1">
                                        <ScrollViewer x:Name="ScrollC2" VerticalScrollBarVisibility="Auto" Margin="10" ScrollChanged="CompararScroll_Changed">
                                            <ItemsControl x:Name="CompararConjunto2ItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="6"
                                                               Height="36"
                                                               Margin="0,0,0,3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource BackgroundMedium}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsVazio}" Value="True">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="14"
                                                                      FontWeight="SemiBold"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsVazio}" Value="True">
                                                                                <Setter Property="Foreground" Value="#444444"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <Run Text="R$ "/>
                                                                <Run Text="{Binding ValorTexto, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <!-- Botão Adicionar Conjunto 2 (direita da lista) -->
                                    <Button Grid.Row="2" Grid.Column="6"
                                           VerticalAlignment="Top"
                                           Height="32"
                                           Margin="10,0,0,0"
                                           Background="{StaticResource PrimaryColor}"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Cursor="Hand"
                                           Click="AdicionarValorConjunto2_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="8"
                                                                   Padding="12,0">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#9140f0"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="+ " FontSize="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="Adicionar Valor" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Botões inferiores -->
                                <StackPanel Grid.Row="4"
                                           Orientation="Horizontal"
                                           HorizontalAlignment="Center">

                                    <!-- Encontrar divergências -->
                                    <Button Height="45"
                                           Width="230"
                                           Margin="0,0,12,0"
                                           Background="{StaticResource PrimaryColor}"
                                           Foreground="White"
                                           BorderThickness="0"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Cursor="Hand"
                                           Click="EncontrarDivergencias_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="8">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#9140f0"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="≡ " FontSize="20" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Encontrar divergências" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Limpar listas -->
                                    <Button Height="45"
                                           Width="90"
                                           BorderThickness="1"
                                           BorderBrush="#444444"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Cursor="Hand"
                                           Click="LimparComparacao_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#2A2A2D"/>
                                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                                   CornerRadius="8">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#3A3A3D"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✕ " FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="Limpar" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                </StackPanel>
                            </Grid>

                            <!-- ============================================ -->
                            <!-- LAYOUT O.P.E.X -->
                            <!-- ============================================ -->
                            <Grid x:Name="OpexLayoutGrid" 
                                  Opacity="0" 
                                  Visibility="Collapsed" 
                                  Margin="20"
                                  Focusable="True"
                                  KeyDown="OpexLayoutGrid_KeyDown">
                                
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- ComboBox Fornecedor -->
                                    <RowDefinition Height="15"/>   <!-- Espaçamento -->
                                    <RowDefinition Height="Auto"/> <!-- Data e Valor -->
                                    <RowDefinition Height="30"/>   <!-- Espaçamento -->
                                    <RowDefinition Height="*"/>    <!-- Lista de Previsões -->
                                    <RowDefinition Height="10"/>   <!-- Espaçamento -->
                                    <RowDefinition Height="Auto"/> <!-- Checkbox Mostrar Pagos -->
                                </Grid.RowDefinitions>
                                
                                <!-- ============================================ -->
                                <!-- COMBOBOX FORNECEDOR -->
                                <!-- ============================================ -->
                                <Border x:Name="OpexFornecedorBorder"
                                        Grid.Row="0"
                                        Background="{DynamicResource BackgroundMedium}"
                                        CornerRadius="6"
                                        Padding="0"
                                        Height="38"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top">
                                    
                                    <Grid>
                                        <!-- ComboBox editável com autocomplete -->
                                        <ComboBox x:Name="OpexFornecedorComboBox"
                                                 IsEditable="True"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextColor}"
                                                 BorderThickness="0"
                                                 Padding="12"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 VerticalContentAlignment="Center"
                                                 StaysOpenOnEdit="True"
                                                 IsTextSearchEnabled="False"
                                                 DisplayMemberPath="Nome"
                                                 TextBoxBase.TextChanged="OpexFornecedorComboBox_TextChanged"
                                                 SelectionChanged="OpexFornecedorComboBox_SelectionChanged"
                                                 PreviewKeyDown="OpexFornecedorComboBox_PreviewKeyDown">
                                            
                                            <ComboBox.Resources>
                                                <!-- Remove o template padrão do botão dropdown -->
                                                <Style TargetType="{x:Type ToggleButton}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                <Grid Background="Transparent">
                                                                    <!-- Área clicável da seta (não interfere no texto) -->
                                                                    <Border Background="Transparent"
                                                                           Width="35"
                                                                           HorizontalAlignment="Right"
                                                                           Cursor="Hand"/>
                                                                    
                                                                    <!-- Seta customizada -->
                                                                    <TextBlock x:Name="OpexArrowIcon"
                                                                              Text="›"
                                                                              FontSize="16"
                                                                              Foreground="{DynamicResource TextColor}"
                                                                              HorizontalAlignment="Right"
                                                                              VerticalAlignment="Center"
                                                                              Margin="0,0,12,0"
                                                                              RenderTransformOrigin="0.5,0.5"
                                                                              IsHitTestVisible="False">
                                                                        <TextBlock.RenderTransform>
                                                                            <RotateTransform x:Name="OpexArrowRotation" Angle="0"/>
                                                                        </TextBlock.RenderTransform>
                                                                    </TextBlock>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Trigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="OpexArrowRotation"
                                                                                                   Storyboard.TargetProperty="Angle"
                                                                                                   To="90"
                                                                                                   Duration="0:0:0.2"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.EnterActions>
                                                                        <Trigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="OpexArrowRotation"
                                                                                                   Storyboard.TargetProperty="Angle"
                                                                                                   To="0"
                                                                                                   Duration="0:0:0.2"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.ExitActions>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                                
                                                <!-- Estilo do TextBox interno -->
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                                    <Setter Property="CaretBrush" Value="{StaticResource PrimaryColor}"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="SelectionBrush" Value="{StaticResource PrimaryColor}"/>
                                                    <Setter Property="SelectionOpacity" Value="0.4"/>
                                                </Style>
                                            </ComboBox.Resources>
                                            
                                            <!-- Estilo dos itens no dropdown -->
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="FontSize" Value="13"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#2A2A2D"/>
                                                        </Trigger>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter Property="Background" Value="#2A2A2D"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            
                                            <!-- Template do ComboBox -->
                                            <ComboBox.Template>
                                                <ControlTemplate TargetType="ComboBox">
                                                    <Grid>
                                                        <ToggleButton x:Name="ToggleButton"
                                                                     Grid.Column="2"
                                                                     Focusable="false"
                                                                     IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                     ClickMode="Press"/>
                                                        
                                                        <ContentPresenter x:Name="ContentSite"
                                                                         IsHitTestVisible="False"
                                                                         Content="{TemplateBinding SelectionBoxItem}"
                                                                         ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                         ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                         Margin="12,0,35,0"
                                                                         VerticalAlignment="Center"
                                                                         HorizontalAlignment="Left"/>
                                                        
                                                        <TextBox x:Name="PART_EditableTextBox"
                                                                Style="{x:Null}"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                Margin="12,0,35,0"
                                                                Focusable="True"
                                                                Background="Transparent"
                                                                Foreground="{DynamicResource TextColor}"
                                                                CaretBrush="{StaticResource PrimaryColor}"
                                                                BorderThickness="0"
                                                                Visibility="Hidden"
                                                                IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                                        
                                                        <Popup x:Name="Popup"
                                                              Placement="Bottom"
                                                              IsOpen="{TemplateBinding IsDropDownOpen}"
                                                              AllowsTransparency="True"
                                                              Focusable="False"
                                                              PopupAnimation="Slide">
                                                            <Grid x:Name="DropDown"
                                                                 MinWidth="{TemplateBinding ActualWidth}"
                                                                 MaxHeight="200"
                                                                 SnapsToDevicePixels="True">
                                                                <Border x:Name="DropDownBorder"
                                                                       Background="{DynamicResource BackgroundMedium}"
                                                                       BorderBrush="{StaticResource AccentColor}"
                                                                       BorderThickness="1"
                                                                       CornerRadius="6"
                                                                       Margin="0,4,0,0">
                                                                    <ScrollViewer Margin="4,6,4,6"
                                                                                 SnapsToDevicePixels="True">
                                                                        <StackPanel IsItemsHost="True"
                                                                                   KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Grid>
                                                        </Popup>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="HasItems" Value="false">
                                                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="false">
                                                            <Setter Property="Foreground" Value="#888888"/>
                                                        </Trigger>
                                                        <Trigger Property="IsGrouping" Value="true">
                                                            <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEditable" Value="true">
                                                            <Setter Property="IsTabStop" Value="false"/>
                                                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ComboBox.Template>
                                        </ComboBox>
                                        
                                        <!-- Placeholder "Fornecedor" quando vazio -->
                                        <TextBlock x:Name="OpexPlaceholder"
                                                  Text="Fornecedor"
                                                  Foreground="{DynamicResource TextColor}"
                                                  FontWeight="SemiBold"
                                                  FontSize="14"
                                                  Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Visibility="Visible"/>
                                    </Grid>
                                </Border>
                                
                                <!-- ============================================ -->
                                <!-- DATA E VALOR -->
                                <!-- ============================================ -->
                                <Grid x:Name="OpexInputsGrid" Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128"/>  <!-- Data -->
                                        <ColumnDefinition Width="8"/>    <!-- Espaçamento -->
                                        <ColumnDefinition Width="128"/>  <!-- Valor -->
                                        <ColumnDefinition Width="8"/>    <!-- Espaçamento -->
                                        <ColumnDefinition Width="76"/>   <!-- Empresa -->
                                        <ColumnDefinition Width="8"/>    <!-- Espaçamento -->
                                        <ColumnDefinition Width="*" MinWidth="100"/>    <!-- Botão Registrar/Atualizar -->
                                        <ColumnDefinition Width="8"/>    <!-- Espaçamento -->
                                        <ColumnDefinition Width="112"/>  <!-- Botão Excluir -->
                                        <ColumnDefinition Width="8"/>    <!-- Espaçamento -->
                                        <ColumnDefinition Width="135"/>  <!-- Botão Movimentar -->
                                        <ColumnDefinition Width="8"/>    <!-- Espaçamento -->
                                        <ColumnDefinition Width="135"/>  <!-- Botão Importar -->
                                        <ColumnDefinition Width="8"/>    <!-- Espaçamento -->
                                        <ColumnDefinition Width="155"/>  <!-- Conferir Pagamentos -->
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Box de Data - TextBox com Formatação Automática -->
                                    <Border x:Name="OpexDataBorder"
                                            Grid.Column="0"
                                            Background="{DynamicResource BackgroundMedium}"
                                            CornerRadius="6"
                                            Height="38">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- TextBox para data com formatação automática -->
                                            <TextBox x:Name="OpexDataTextBox"
                                                    Grid.Column="0"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextColor}"
                                                    BorderThickness="0"
                                                    Padding="12,0,8,0"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    VerticalContentAlignment="Center"
                                                    CaretBrush="{StaticResource PrimaryColor}"
                                                    MaxLength="10"
                                                    PreviewTextInput="OpexDataTextBox_PreviewTextInput"
                                                    TextChanged="OpexDataTextBox_TextChanged"
                                                    PreviewKeyDown="OpexDataTextBox_PreviewKeyDown">
                                                <TextBox.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="0"/>
                                                    </Style>
                                                </TextBox.Resources>
                                            </TextBox>
                                            
                                            <!-- Placeholder "Data" -->
                                            <TextBlock x:Name="OpexDataPlaceholder"
                                                      Grid.Column="0"
                                                      Text="Data"
                                                      Foreground="#666666"
                                                      FontWeight="SemiBold"
                                                      FontSize="14"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Visibility="Visible"/>
                                            
                                            <!-- Ícone de calendário -->
                                            <Viewbox Grid.Column="1"
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,0,12,0"
                                                    IsHitTestVisible="False">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"
                                                          Fill="{DynamicResource TextColor}"
                                                          Opacity="0.7"/>
                                                    <Rectangle Canvas.Left="7" Canvas.Top="11" Width="2" Height="2" Fill="{DynamicResource TextColor}" Opacity="0.7"/>
                                                    <Rectangle Canvas.Left="11" Canvas.Top="11" Width="2" Height="2" Fill="{DynamicResource TextColor}" Opacity="0.7"/>
                                                    <Rectangle Canvas.Left="15" Canvas.Top="11" Width="2" Height="2" Fill="{DynamicResource TextColor}" Opacity="0.7"/>
                                                    <Rectangle Canvas.Left="7" Canvas.Top="15" Width="2" Height="2" Fill="{DynamicResource TextColor}" Opacity="0.7"/>
                                                    <Rectangle Canvas.Left="11" Canvas.Top="15" Width="2" Height="2" Fill="{DynamicResource TextColor}" Opacity="0.7"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Box de Valor -->
                                    <Border x:Name="OpexValorBorder"
                                            Grid.Column="2"
                                            Background="{DynamicResource BackgroundMedium}"
                                            CornerRadius="6"
                                            Height="38">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- R$ -->
                                                <ColumnDefinition Width="*"/>    <!-- TextBox -->
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Símbolo R$ fixo -->
                                            <TextBlock Grid.Column="0"
                                                      Text="R$"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="Bold"
                                                      FontSize="14"
                                                      Margin="12,0,5,0"
                                                      VerticalAlignment="Center"/>
                                            
                                            <!-- TextBox para valor -->
                                            <TextBox x:Name="OpexValorTextBox"
                                                    Grid.Column="1"
                                                    Background="Transparent"
                                                    Foreground="{DynamicResource TextColor}"
                                                    BorderThickness="0"
                                                    Padding="0,0,12,0"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    VerticalContentAlignment="Center"
                                                    CaretBrush="{StaticResource PrimaryColor}"
                                                    PreviewTextInput="OpexValorTextBox_PreviewTextInput"
                                                    TextChanged="OpexValorTextBox_TextChanged">
                                                <TextBox.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="0"/>
                                                    </Style>
                                                </TextBox.Resources>
                                            </TextBox>
                                            
                                            <!-- Placeholder "0,00" -->
                                            <TextBlock x:Name="OpexValorPlaceholder"
                                                      Grid.Column="1"
                                                      Text="0,00"
                                                      Foreground="#666666"
                                                      FontWeight="SemiBold"
                                                      FontSize="14"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Visibility="Visible"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Box de Empresa (ADM/COR) -->
                                    <Border x:Name="OpexEmpresaBorder"
                                            Grid.Column="4"
                                            Background="{DynamicResource BackgroundMedium}"
                                            CornerRadius="6"
                                            Height="38">
                                        <Grid>
                                            <ComboBox x:Name="OpexEmpresaComboBox"
                                                     Background="Transparent"
                                                     Foreground="{DynamicResource TextColor}"
                                                     BorderThickness="0"
                                                     Padding="12"
                                                     FontSize="13"
                                                     FontWeight="Bold"
                                                     VerticalContentAlignment="Center"
                                                     SelectionChanged="OpexEmpresaComboBox_SelectionChanged">
                                                
                                                <ComboBoxItem Content="ADM" Foreground="#4CAF50"/>
                                                <ComboBoxItem Content="COR" Foreground="#2196F3"/>
                                                
                                                <ComboBox.Resources>
                                                    <!-- Template do botão dropdown -->
                                                    <Style TargetType="{x:Type ToggleButton}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                    <Grid Background="Transparent">
                                                                        <!-- Área clicável da seta -->
                                                                        <Border Background="Transparent"
                                                                               Width="35"
                                                                               HorizontalAlignment="Right"
                                                                               Cursor="Hand"/>
                                                                        
                                                                        <!-- Seta customizada -->
                                                                        <TextBlock x:Name="EmpresaArrowIcon"
                                                                                  Text="›"
                                                                                  FontSize="16"
                                                                                  Foreground="{DynamicResource TextColor}"
                                                                                  HorizontalAlignment="Right"
                                                                                  VerticalAlignment="Center"
                                                                                  Margin="0,0,12,0"
                                                                                  RenderTransformOrigin="0.5,0.5"
                                                                                  IsHitTestVisible="False">
                                                                            <TextBlock.RenderTransform>
                                                                                <RotateTransform x:Name="EmpresaArrowRotation" Angle="0"/>
                                                                            </TextBlock.RenderTransform>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Trigger.EnterActions>
                                                                                <BeginStoryboard>
                                                                                    <Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetName="EmpresaArrowRotation"
                                                                                                       Storyboard.TargetProperty="Angle"
                                                                                                       To="90"
                                                                                                       Duration="0:0:0.2"/>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </Trigger.EnterActions>
                                                                            <Trigger.ExitActions>
                                                                                <BeginStoryboard>
                                                                                    <Storyboard>
                                                                                        <DoubleAnimation Storyboard.TargetName="EmpresaArrowRotation"
                                                                                                       Storyboard.TargetProperty="Angle"
                                                                                                       To="0"
                                                                                                       Duration="0:0:0.2"/>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </Trigger.ExitActions>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ComboBox.Resources>
                                                
                                                <!-- Estilo dos itens no dropdown -->
                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Padding" Value="12,8"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#2A2A2D"/>
                                                            </Trigger>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter Property="Background" Value="#2A2A2D"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                                
                                                <!-- Template do ComboBox -->
                                                <ComboBox.Template>
                                                    <ControlTemplate TargetType="ComboBox">
                                                        <Grid>
                                                            <ToggleButton x:Name="ToggleButton"
                                                                         Grid.Column="2"
                                                                         Focusable="false"
                                                                         IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                         ClickMode="Press"/>
                                                            
                                                            <ContentPresenter x:Name="ContentSite"
                                                                             IsHitTestVisible="False"
                                                                             Content="{TemplateBinding SelectionBoxItem}"
                                                                             ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                             ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                             Margin="12,0,35,0"
                                                                             VerticalAlignment="Center"
                                                                             HorizontalAlignment="Left"/>
                                                            
                                                            <Popup x:Name="Popup"
                                                                  Placement="Bottom"
                                                                  IsOpen="{TemplateBinding IsDropDownOpen}"
                                                                  AllowsTransparency="True"
                                                                  Focusable="False"
                                                                  PopupAnimation="Slide">
                                                                <Grid x:Name="DropDown"
                                                                     MinWidth="{TemplateBinding ActualWidth}"
                                                                     MaxHeight="200"
                                                                     SnapsToDevicePixels="True">
                                                                    <Border x:Name="DropDownBorder"
                                                                           Background="{DynamicResource BackgroundMedium}"
                                                                           BorderBrush="{StaticResource AccentColor}"
                                                                           BorderThickness="1"
                                                                           CornerRadius="6"
                                                                           Margin="0,4,0,0">
                                                                        <ScrollViewer Margin="4,6,4,6"
                                                                                     SnapsToDevicePixels="True">
                                                                            <StackPanel IsItemsHost="True"
                                                                                       KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                                        </ScrollViewer>
                                                                    </Border>
                                                                </Grid>
                                                            </Popup>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="HasItems" Value="false">
                                                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="false">
                                                                <Setter Property="Foreground" Value="#888888"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ComboBox.Template>
                                            </ComboBox>
                                            
                                            <!-- Placeholder "Empresa" -->
                                            <TextBlock x:Name="OpexEmpresaPlaceholder"
                                                      Text="Empresa"
                                                      Foreground="#666666"
                                                      FontWeight="SemiBold"
                                                      FontSize="13"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"
                                                      Visibility="Visible"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Botão Registrar/Atualizar (Dinâmico) -->
                                    <Button x:Name="BtnRegistrarPagamento"
                                            Grid.Column="6"
                                            Content="Registrar Pagamento"
                                            Height="38"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="BtnRegistrarPagamento_Click"
                                            IsEnabled="False"
                                            Opacity="0.4"/>
                                    
                                    <!-- Botão Excluir -->
                                    <Button x:Name="BtnExcluirPagamento"
                                            Grid.Column="8"
                                            Content="Excluir Registro"
                                            Height="38"
                                            Background="#C42B1C"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            FontSize="13"
                                            Cursor="Hand"
                                            Click="BtnExcluirPagamento_Click"
                                            IsEnabled="False"
                                            Opacity="0.4">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#C42B1C"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="6"
                                                                   BorderThickness="0">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#A02315"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#555555"/>
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    
                                    <!-- Botão Importar -->
                                    <Button x:Name="BtnImportar"
                                            Grid.Column="10"
                                            Content="Importar"
                                            Height="38"
                                            Background="{StaticResource PrimaryColor}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            FontSize="13"
                                            Cursor="Hand"
                                            Click="BtnImportar_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="6"
                                                                   BorderThickness="0">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    
                                    <!-- Botão Movimentar Registros -->
                                    <Button x:Name="BtnMovimentarRegistros"
                                            Grid.Column="12"
                                            Content="Movimentar Registros"
                                            Height="38"
                                            Background="{StaticResource PrimaryColor}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            FontSize="13"
                                            Cursor="Hand"
                                            Click="BtnMovimentarRegistros_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="6"
                                                                   BorderThickness="0">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- Botão Conferir Pagamentos -->
                                    <Button x:Name="BtnConferirPagamentos"
                                            Grid.Column="14"
                                            Content="Conferir Pagamentos"
                                            Height="38"
                                            Background="#2D6D50"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            FontSize="13"
                                            Cursor="Hand"
                                            Click="BtnConferirPagamentos_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#2D6D50"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                   CornerRadius="6"
                                                                   BorderThickness="0">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#388563"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                
                                <!-- ============================================ -->
                                <!-- LISTA DE PREVISÕES DE PAGAMENTO -->
                                <!-- ============================================ -->
                                <Border Grid.Row="4"
                                        Background="#99252526"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1">
                                    
                                    <Grid Margin="0" Grid.IsSharedSizeScope="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Cabeçalho -->
                                            <RowDefinition Height="*"/>    <!-- Lista -->
                                        </Grid.RowDefinitions>
                                        
                                        <!-- CABEÇALHO DA LISTA -->
                                        <Grid Grid.Row="0" 
                                              Background="#992A2A2D"
                                              Height="45">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColCodigo"/>   <!-- Código -->
                                                <ColumnDefinition Width="*"/>                                   <!-- Nome -->
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColTipoPgto"/> <!-- Tipo Pgto -->
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColNatureza"/> <!-- Natureza -->
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColValor"/>    <!-- Valor -->
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColData"/>     <!-- Data -->
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColEmpresa"/>  <!-- Empresa -->
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ColStatus"/>   <!-- Status -->
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" 
                                                      Text="Código"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="Bold"
                                                      FontSize="13"
                                                      VerticalAlignment="Center"
                                                      Margin="20,0,10,0"/>
                                            
                                            <TextBlock Grid.Column="1" 
                                                      Text="Fornecedor"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="Bold"
                                                      FontSize="13"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0"/>

                                            <TextBlock Grid.Column="2" 
                                                      Text="Tipo Pgto"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="Bold"
                                                      FontSize="13"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0"/>
                                            
                                            <TextBlock Grid.Column="3" 
                                                      Text="Natureza"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="Bold"
                                                      FontSize="13"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0"/>
                                            
                                            <TextBlock Grid.Column="4" 
                                                      Text="Valor"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="Bold"
                                                      FontSize="13"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0"/>
                                            
                                            <TextBlock Grid.Column="5" 
                                                      Text="Data Pgto."
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="Bold"
                                                      FontSize="13"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0"/>
                                            
                                            <TextBlock Grid.Column="6" 
                                                      Text="Empresa"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="Bold"
                                                      FontSize="13"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0"/>
                                            
                                            <TextBlock Grid.Column="7" 
                                                      Text="Status"
                                                      Foreground="{DynamicResource TextColor}"
                                                      FontWeight="Bold"
                                                      FontSize="13"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0,20,0"/>
                                        </Grid>
                                        
                                        <!-- LISTA DE PAGAMENTOS COM SCROLL -->
                                        <ScrollViewer Grid.Row="1"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Disabled"
                                                     Background="Transparent"
                                                     Margin="0">
                                            
                                            <ItemsControl x:Name="PagamentosItemsControl"
                                                         Background="Transparent"
                                                         Margin="0">
                                                
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="Transparent"
                                                               BorderThickness="0"
                                                               Padding="0"
                                                               Margin="0"
                                                               MouseLeftButtonDown="PagamentoItem_MouseLeftButtonDown"
                                                               Tag="{Binding}">
                                                            
                                                            <!-- Menu de Contexto (Botão Direito) -->
                                                            <Border.ContextMenu>
                                                                <ContextMenu Background="{StaticResource BackgroundMedium}"
                                                                           BorderBrush="{StaticResource PrimaryColor}"
                                                                           BorderThickness="1"
                                                                           Padding="4"
                                                                           HasDropShadow="True">
                                                                    <ContextMenu.Resources>
                                                                        <!-- Template customizado para bordas arredondadas -->
                                                                        <Style TargetType="ContextMenu">
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="ContextMenu">
                                                                                        <Border Background="{TemplateBinding Background}"
                                                                                               BorderBrush="{TemplateBinding BorderBrush}"
                                                                                               BorderThickness="{TemplateBinding BorderThickness}"
                                                                                               CornerRadius="8"
                                                                                               Padding="{TemplateBinding Padding}">
                                                                                            <StackPanel IsItemsHost="True"/>
                                                                                        </Border>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                        
                                                                        <!-- Estilo melhorado para MenuItem -->
                                                                        <Style TargetType="MenuItem">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
                                                                            <Setter Property="Padding" Value="12,10"/>
                                                                            <Setter Property="FontSize" Value="13"/>
                                                                            <Setter Property="FontWeight" Value="Medium"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="MenuItem">
                                                                                        <Border Name="Border"
                                                                                               Background="{TemplateBinding Background}"
                                                                                               CornerRadius="6"
                                                                                               Margin="2">
                                                                                            <Grid>
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                
                                                                                                <!-- Ícone -->
                                                                                                <ContentPresenter Grid.Column="0"
                                                                                                                ContentSource="Icon"
                                                                                                                Margin="8,0,12,0"
                                                                                                                VerticalAlignment="Center"/>
                                                                                                
                                                                                                <!-- Texto -->
                                                                                                <ContentPresenter Grid.Column="1"
                                                                                                                ContentSource="Header"
                                                                                                                VerticalAlignment="Center"
                                                                                                                Margin="0,0,12,0"/>
                                                                                            </Grid>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                                <Setter Property="Foreground" Value="#666666"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </ContextMenu.Resources>
                                                                    
                                                                    <!-- Menu Item: Copiar Natureza -->
                                                                    <MenuItem Header="Copiar Natureza"
                                                                             Click="CopiarNatureza_Click">
                                                                        <MenuItem.Icon>
                                                                            <TextBlock Text="📋" 
                                                                                      FontSize="16"
                                                                                      VerticalAlignment="Center"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    
                                                                    <!-- Menu Item: Copiar Código -->
                                                                    <MenuItem Header="Copiar Código"
                                                                             Click="CopiarCodigo_Click">
                                                                        <MenuItem.Icon>
                                                                            <TextBlock Text="🔢" 
                                                                                      FontSize="16"
                                                                                      VerticalAlignment="Center"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            
                                                            <Grid Height="38"
                                                                 Background="Transparent">
                                                                
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColCodigo"/>   <!-- Código -->
                                                                    <ColumnDefinition Width="*"/>                                   <!-- Nome -->
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColTipoPgto"/> <!-- Tipo Pgto -->
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColNatureza"/> <!-- Natureza -->
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColValor"/>    <!-- Valor -->
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColData"/>     <!-- Data -->
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColEmpresa"/>  <!-- Empresa -->
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ColStatus"/>   <!-- Status -->
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <!-- Linha separadora inferior -->
                                                                <Border Grid.ColumnSpan="8"
                                                                       Height="1"
                                                                       Background="{DynamicResource BorderColor}"
                                                                       VerticalAlignment="Bottom"
                                                                       Opacity="0.3"/>
                                                                
                                                                <!-- Código com 6 dígitos - SELECIONÁVEL -->
                                                                <TextBox Grid.Column="0"
                                                                        Text="{Binding CodigoFornecedor, StringFormat='{}{0:D6}'}"
                                                                        Foreground="{DynamicResource TextColor}"
                                                                        FontSize="12"
                                                                        FontWeight="SemiBold"
                                                                        FontFamily="Consolas"
                                                                        VerticalAlignment="Center"
                                                                        Margin="20,0,10,0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        IsReadOnly="True"
                                                                        Cursor="IBeam"/>
                                                                
                                                                <!-- Nome do Fornecedor -->
                                                                <TextBlock Grid.Column="1"
                                                                          Text="{Binding NomeFornecedor}"
                                                                          Foreground="{DynamicResource TextColor}"
                                                                          FontSize="12"
                                                                          VerticalAlignment="Center"
                                                                          TextTrimming="CharacterEllipsis"
                                                                          Margin="10,0"/>

                                                                <!-- Tipo de Pagamento (oculto se 0) -->
                                                                <TextBlock Grid.Column="2"
                                                                          Foreground="{DynamicResource TextColor}"
                                                                          FontSize="12"
                                                                          FontFamily="Consolas"
                                                                          VerticalAlignment="Center"
                                                                          Margin="10,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding TipoPagamento}" Value="1">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Text" Value="01"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding TipoPagamento}" Value="2">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Text" Value="02"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding TipoPagamento}" Value="3">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Setter Property="Text" Value="03"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                
                                                                <!-- Natureza - SELECIONÁVEL -->
                                                                <TextBox Grid.Column="3"
                                                                        Text="{Binding Natureza}"
                                                                        Foreground="{DynamicResource TextColor}"
                                                                        FontSize="12"
                                                                        VerticalAlignment="Center"
                                                                        Margin="10,0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        IsReadOnly="True"
                                                                        Cursor="IBeam"/>
                                                                
                                                                <!-- Valor -->
                                                                <TextBlock Grid.Column="4"
                                                                          Foreground="#4CAF50"
                                                                          FontSize="12"
                                                                          FontWeight="Bold"
                                                                          VerticalAlignment="Center"
                                                                          Margin="10,0">
                                                                    <Run Text="R$ "/>
                                                                    <Run Text="{Binding Valor, StringFormat=N2}"/>
                                                                </TextBlock>
                                                                
                                                                <!-- Data de Pagamento -->
                                                                <TextBlock Grid.Column="5"
                                                                          Text="{Binding DataPagamento, StringFormat=dd/MM/yyyy}"
                                                                          Foreground="{DynamicResource TextColor}"
                                                                          FontSize="12"
                                                                          VerticalAlignment="Center"
                                                                          Margin="10,0"/>
                                                                
                                                                <!-- Empresa (ADM/COR) -->
                                                                <TextBlock Grid.Column="6"
                                                                          Text="{Binding Empresa}"
                                                                          FontSize="11"
                                                                          FontWeight="Bold"
                                                                          VerticalAlignment="Center"
                                                                          Margin="10,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Empresa}" Value="ADM">
                                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Empresa}" Value="COR">
                                                                                    <Setter Property="Foreground" Value="#2196F3"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                
                                                                <!-- Status -->
                                                                <Border Grid.Column="7"
                                                                       CornerRadius="10"
                                                                       Padding="10,3"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0,20,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Pendente">
                                                                                    <Setter Property="Background" Value="#FFA500"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="No Banco">
                                                                                    <Setter Property="Background" Value="#47bddb"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Pago">
                                                                                    <Setter Property="Background" Value="#4CAF50"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding Status}"
                                                                              Foreground="White"
                                                                              FontSize="10"
                                                                              FontWeight="SemiBold"/>
                                                                </Border>
                                                                
                                                                <!-- Efeito hover -->
                                                                <Border x:Name="HoverBorder"
                                                                       Grid.ColumnSpan="8"
                                                                       Background="{StaticResource PrimaryColor}"
                                                                       Opacity="0"/>
                                                            </Grid>
                                                            
                                                            <!-- Triggers para hover -->
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
                                                                            <Setter Property="Cursor" Value="Hand"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                
                                <!-- Checkboxes de Filtro (embaixo) -->
                                <StackPanel Grid.Row="6"
                                           Orientation="Horizontal"
                                           HorizontalAlignment="Right">
                                    
                                    <!-- Checkbox Somente ADM -->
                                    <Border Background="#2D2D30"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Margin="0,0,10,0">
                                        <CheckBox x:Name="SomenteAdmCheckBox"
                                                 Content="Somente ADM"
                                                 Style="{StaticResource CustomCheckBoxStyle}"
                                                 VerticalAlignment="Center"
                                                 Checked="SomenteAdmCheckBox_Changed"
                                                 Unchecked="SomenteAdmCheckBox_Changed">
                                            <CheckBox.Resources>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource CustomCheckBoxStyle}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="CheckBox">
                                                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                                                    <Border x:Name="CheckBoxBorder"
                                                                           Width="20" 
                                                                           Height="20" 
                                                                           Background="{DynamicResource BackgroundDark}"
                                                                           BorderBrush="{StaticResource PrimaryColor}"
                                                                           BorderThickness="2"
                                                                           CornerRadius="4"
                                                                           Margin="0,0,8,0">
                                                                        <TextBlock x:Name="CheckMark"
                                                                                  Text="✓"
                                                                                  Foreground="{StaticResource PrimaryColor}"
                                                                                  FontSize="14"
                                                                                  FontWeight="Bold"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Visibility="Collapsed"/>
                                                                    </Border>
                                                                    <ContentPresenter VerticalAlignment="Center"
                                                                                    RecognizesAccessKey="True"/>
                                                                </StackPanel>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverColor}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </CheckBox.Resources>
                                        </CheckBox>
                                    </Border>
                                    
                                    <!-- Checkbox Somente COR -->
                                    <Border Background="#2D2D30"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Margin="0,0,10,0">
                                        <CheckBox x:Name="SomenteCorCheckBox"
                                                 Content="Somente COR"
                                                 Style="{StaticResource CustomCheckBoxStyle}"
                                                 VerticalAlignment="Center"
                                                 Checked="SomenteCorCheckBox_Changed"
                                                 Unchecked="SomenteCorCheckBox_Changed">
                                            <CheckBox.Resources>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource CustomCheckBoxStyle}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="CheckBox">
                                                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                                                    <Border x:Name="CheckBoxBorder"
                                                                           Width="20" 
                                                                           Height="20" 
                                                                           Background="{DynamicResource BackgroundDark}"
                                                                           BorderBrush="{StaticResource PrimaryColor}"
                                                                           BorderThickness="2"
                                                                           CornerRadius="4"
                                                                           Margin="0,0,8,0">
                                                                        <TextBlock x:Name="CheckMark"
                                                                                  Text="✓"
                                                                                  Foreground="{StaticResource PrimaryColor}"
                                                                                  FontSize="14"
                                                                                  FontWeight="Bold"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Visibility="Collapsed"/>
                                                                    </Border>
                                                                    <ContentPresenter VerticalAlignment="Center"
                                                                                    RecognizesAccessKey="True"/>
                                                                </StackPanel>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverColor}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </CheckBox.Resources>
                                        </CheckBox>
                                    </Border>
                                    
                                    <!-- Checkbox Mostrar Pagos -->
                                    <Border Background="#2D2D30"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6">
                                        <CheckBox x:Name="MostrarPagosCheckBox"
                                                 Content="Mostrar Pagos"
                                                 Style="{StaticResource CustomCheckBoxStyle}"
                                                 VerticalAlignment="Center"
                                                 Checked="MostrarPagosCheckBox_Changed"
                                                 Unchecked="MostrarPagosCheckBox_Changed">
                                            <CheckBox.Resources>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource CustomCheckBoxStyle}">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="CheckBox">
                                                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                                                    <Border x:Name="CheckBoxBorder"
                                                                           Width="20" 
                                                                           Height="20" 
                                                                           Background="{DynamicResource BackgroundDark}"
                                                                           BorderBrush="{StaticResource PrimaryColor}"
                                                                           BorderThickness="2"
                                                                           CornerRadius="4"
                                                                           Margin="0,0,8,0">
                                                                        <TextBlock x:Name="CheckMark"
                                                                                  Text="✓"
                                                                                  Foreground="{StaticResource PrimaryColor}"
                                                                                  FontSize="14"
                                                                                  FontWeight="Bold"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Visibility="Collapsed"/>
                                                                    </Border>
                                                                    <ContentPresenter VerticalAlignment="Center"
                                                                                    RecognizesAccessKey="True"/>
                                                                </StackPanel>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverColor}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </CheckBox.Resources>
                                        </CheckBox>
                                    </Border>
                                    
                                </StackPanel>
                                
                            </Grid>

                            <!-- ============================================ -->
                            <!-- DECODIFICADOR / CRIADOR CNAB LAYOUT -->
                            <!-- ============================================ -->
                            <Grid x:Name="DecodificadorCnabLayout"
                                  Opacity="0"
                                  Visibility="Collapsed"
                                  Margin="40">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Decodificador CNAB"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextColor}"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                                    <ToggleButton x:Name="CnabAbaDecodificarButton"
                                                  Content="Decodificar CNAB"
                                                  IsChecked="True"
                                                  Style="{StaticResource CnabTabToggleStyle}"
                                                  Click="CnabAbaDecodificar_Click"/>
                                    <ToggleButton x:Name="CnabAbaCriarButton"
                                                  Content="Criar CNAB"
                                                  Style="{StaticResource CnabTabToggleStyle}"
                                                  Click="CnabAbaCriar_Click"/>
                                    <ToggleButton x:Name="CnabAbaCadastroButton"
                                                  Content="Cadastro de Colaborador"
                                                  Style="{StaticResource CnabTabToggleStyle}"
                                                  MinWidth="190"
                                                  Click="CnabAbaCadastro_Click"/>
                                </StackPanel>

                                <!-- =================================================== -->
                                <!-- ABA 1: DECODIFICAR CNAB                            -->
                                <!-- =================================================== -->
                                <Grid x:Name="CnabDecodificarTabPanel" Grid.Row="3">
                                    <!-- ETAPA 1: seleção / arrastar arquivo -->
                                    <Grid x:Name="CnabImportPanel">
                                        <Grid x:Name="CnabDropZone"
                                              AllowDrop="True"
                                              Cursor="Hand"
                                              MouseLeftButtonDown="CnabDropZone_MouseLeftButtonDown"
                                              DragOver="CnabDropZone_DragOver"
                                              Drop="CnabDropZone_Drop"
                                              Margin="0,4,0,0">
                                            <Rectangle Stroke="{StaticResource PrimaryColor}"
                                                       StrokeThickness="2"
                                                       StrokeDashArray="7 4"
                                                       RadiusX="12"
                                                       RadiusY="12"
                                                       Fill="{DynamicResource BackgroundMedium}"/>

                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                                                <Border Width="66" Height="66" CornerRadius="33" Background="#342244" Margin="0,0,0,18">
                                                    <TextBlock Text="&#xE8E5;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="30"
                                                               Foreground="{StaticResource PrimaryColor}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Arraste seu arquivo CNAB para cá"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextColor}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="ou clique para selecionar o arquivo"
                                                           FontSize="14"
                                                           Foreground="#92929A"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                                <Border Background="#242126" CornerRadius="6" Padding="12,7" Margin="0,20,0,0">
                                                    <TextBlock Text="Nesta versão: Santander 033 · CNAB 240 · Segmentos A/B"
                                                               FontSize="12"
                                                               Foreground="#B9A7CA"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- ETAPA 2: arquivo decodificado -->
                                    <Grid x:Name="CnabEditorPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Background="#232329" BorderBrush="{StaticResource AccentColor}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock x:Name="CnabArquivoTextBlock" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="CnabLayoutTextBlock" Margin="0,3,0,0" FontSize="12" Foreground="#9B9BA2"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Trocar arquivo" Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,0,0" Padding="4,0" Click="CnabTrocarArquivo_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2" Background="#232329" BorderThickness="0" CornerRadius="12" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="CnabAlterarTodosCheckBox"
                                                          Grid.Column="0"
                                                          IsChecked="True"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource TextColor}"
                                                          FontWeight="SemiBold"
                                                          Style="{StaticResource CustomCheckBoxStyle}"
                                                          Content="Alterar data de todos"
                                                          Checked="CnabAlterarTodosCheckBox_Changed"
                                                          Unchecked="CnabAlterarTodosCheckBox_Changed"/>
                                                <TextBox x:Name="CnabDataTodosTextBox"
                                                         Grid.Column="2"
                                                         Style="{StaticResource CnabRoundedTextBoxStyle}"
                                                         FontSize="14"
                                                         MaxLength="10"
                                                         ToolTip="DD/MM/AAAA"
                                                         TextChanged="CnabDataTodosTextBox_TextChanged"/>
                                                <TextBlock Grid.Column="3"
                                                           Margin="14,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#8D8D95"
                                                           FontSize="12"
                                                           Text="Quando marcado, a data digitada é aplicada a todos os pagamentos."/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="4" BorderThickness="0" CornerRadius="12" Background="#202022" ClipToBounds="True">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="42"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="#29292C">
                                                    <Grid Margin="12,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.8*"/>
                                                            <ColumnDefinition Width="1.05*"/>
                                                            <ColumnDefinition Width="1.05*"/>
                                                            <ColumnDefinition Width="84"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Favorecido" VerticalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="Valor" VerticalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                                        <TextBlock Grid.Column="2" Text="Data" VerticalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                                        <TextBlock Grid.Column="3" Text="Ações" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl x:Name="CnabPagamentosItemsControl">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#242426" BorderBrush="#2F2438" BorderThickness="0,0,0,1" CornerRadius="8" Padding="14,9" Margin="6,2">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2.8*"/>
                                                                            <ColumnDefinition Width="1.05*"/>
                                                                            <ColumnDefinition Width="1.05*"/>
                                                                            <ColumnDefinition Width="84"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Nome}" Foreground="{DynamicResource TextColor}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nome}"/>
                                                                            <TextBlock Text="{Binding DocumentoFavorecido, StringFormat='Documento: {0}'}" Foreground="#77777F" FontSize="10" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                        <TextBox Grid.Column="1" Text="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CnabRoundedTextBoxStyle}" Margin="10,0,0,0" LostFocus="CnabValorTextBox_LostFocus"/>
                                                                        <TextBox Grid.Column="2" Text="{Binding DataTexto, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataIndividualHabilitada}" Style="{StaticResource CnabRoundedTextBoxStyle}" Margin="10,0,0,0" MaxLength="10" LostFocus="CnabDataTextBox_LostFocus"/>
                                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Button Style="{StaticResource CnabActionIconButtonStyle}" ToolTip="Ver dados bancários" Click="CnabBanco_Click">
                                                                                <Viewbox Width="16" Height="16">
                                                                                    <Canvas Width="24" Height="24">
                                                                                        <Polygon Points="12,3 22,8 2,8" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                                                                                        <Rectangle Canvas.Left="4" Canvas.Top="10" Width="3" Height="8" RadiusX="0.8" RadiusY="0.8" Stroke="White" StrokeThickness="1.6" Fill="Transparent"/>
                                                                                        <Rectangle Canvas.Left="10.5" Canvas.Top="10" Width="3" Height="8" RadiusX="0.8" RadiusY="0.8" Stroke="White" StrokeThickness="1.6" Fill="Transparent"/>
                                                                                        <Rectangle Canvas.Left="17" Canvas.Top="10" Width="3" Height="8" RadiusX="0.8" RadiusY="0.8" Stroke="White" StrokeThickness="1.6" Fill="Transparent"/>
                                                                                        <Line X1="2" Y1="20" X2="22" Y2="20" Stroke="White" StrokeThickness="1.8"/>
                                                                                        <Line X1="1" Y1="22" X2="23" Y2="22" Stroke="White" StrokeThickness="1.8"/>
                                                                                    </Canvas>
                                                                                </Viewbox>
                                                                            </Button>
                                                                            <Button Style="{StaticResource CnabActionIconButtonStyle}" Foreground="#D56A6A" ToolTip="Excluir pagamento" Click="CnabExcluir_Click">
                                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="CnabResumoTextBlock" Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="O arquivo original não é alterado. Um novo CNAB será gerado." Foreground="#7F7F87" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="BtnSalvarCnab" Grid.Column="1" Content="Salvar novo CNAB" Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,0,0" Click="CnabSalvar_Click"/>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!-- =================================================== -->
                                <!-- ABA 2: CRIAR CNAB                                  -->
                                <!-- =================================================== -->
                                <Grid x:Name="CnabCriarTabPanel" Grid.Row="3" Visibility="Collapsed">
                                    <!-- ETAPA 1: receber o PDF de Vale Transporte -->
                                    <Grid x:Name="CnabCriarImportPanel">
                                        <Grid x:Name="CnabCriarDropZone"
                                              AllowDrop="True"
                                              Cursor="Hand"
                                              MouseLeftButtonDown="CnabCriarDropZone_MouseLeftButtonDown"
                                              DragOver="CnabCriarDropZone_DragOver"
                                              Drop="CnabCriarDropZone_Drop"
                                              Margin="0,4,0,0">
                                            <Rectangle Stroke="{StaticResource PrimaryColor}"
                                                       StrokeThickness="2"
                                                       StrokeDashArray="7 4"
                                                       RadiusX="12"
                                                       RadiusY="12"
                                                       Fill="{DynamicResource BackgroundMedium}"/>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                                                <Border Width="66" Height="66" CornerRadius="33" Background="#342244" Margin="0,0,0,18">
                                                    <TextBlock Text="&#xE8A5;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="30"
                                                               Foreground="{StaticResource PrimaryColor}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Arraste o relatório de Vale Transporte"
                                                           FontSize="20"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextColor}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="ou clique para selecionar o PDF"
                                                           FontSize="14"
                                                           Foreground="#92929A"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                                <Border Background="#242126" CornerRadius="6" Padding="12,7" Margin="0,20,0,0">
                                                    <TextBlock Text="O sistema identifica a competência, valores e sugere a data do pagamento automaticamente."
                                                               FontSize="12"
                                                               Foreground="#B9A7CA"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- ETAPA 2: conferir dados antes de gerar -->
                                    <Grid x:Name="CnabCriarEditorPanel" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- arquivo/fonte em edição: único box com contorno roxo -->
                                        <Border Grid.Row="0" Background="#232329" BorderBrush="{StaticResource AccentColor}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock x:Name="CnabCriarArquivoTextBlock" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="CnabCriarLayoutTextBlock" Margin="0,3,0,0" FontSize="12" Foreground="#9B9BA2"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Trocar PDF"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Margin="16,0,0,0"
                                                        Padding="4,0"
                                                        Click="CnabCriarTrocarArquivo_Click"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="2" Background="#232329" BorderThickness="0" CornerRadius="12" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="CnabCriarAlterarTodosCheckBox"
                                                          Grid.Column="0"
                                                          IsChecked="True"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource TextColor}"
                                                          FontWeight="SemiBold"
                                                          Style="{StaticResource CustomCheckBoxStyle}"
                                                          Content="Alterar data de todos"
                                                          Checked="CnabCriarAlterarTodosCheckBox_Changed"
                                                          Unchecked="CnabCriarAlterarTodosCheckBox_Changed"/>
                                                <TextBox x:Name="CnabCriarDataTodosTextBox"
                                                         Grid.Column="2"
                                                         Style="{StaticResource CnabRoundedTextBoxStyle}"
                                                         FontSize="14"
                                                         MaxLength="10"
                                                         ToolTip="DD/MM/AAAA"
                                                         TextChanged="CnabCriarDataTodosTextBox_TextChanged"/>
                                                <TextBlock Grid.Column="3"
                                                           Margin="14,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#8D8D95"
                                                           FontSize="12"
                                                           Text="Sugerida pelo dia 25 da competência; sábado/domingo é antecipado para sexta-feira."/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Row="4" BorderThickness="0" CornerRadius="12" Background="#202022" ClipToBounds="True">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="42"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="#29292C">
                                                    <Grid Margin="12,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2.8*"/>
                                                            <ColumnDefinition Width="1.05*"/>
                                                            <ColumnDefinition Width="1.05*"/>
                                                            <ColumnDefinition Width="84"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Favorecido" VerticalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="Valor" VerticalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                                        <TextBlock Grid.Column="2" Text="Data" VerticalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                                        <TextBlock Grid.Column="3" Text="Ações" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl x:Name="CnabCriarPagamentosItemsControl">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#242426" BorderBrush="#2F2438" BorderThickness="0,0,0,1" CornerRadius="8" Padding="14,9" Margin="6,2">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="2.8*"/>
                                                                            <ColumnDefinition Width="1.05*"/>
                                                                            <ColumnDefinition Width="1.05*"/>
                                                                            <ColumnDefinition Width="84"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Nome}" Foreground="{DynamicResource TextColor}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nome}"/>
                                                                            <TextBlock FontSize="10" Margin="0,2,0,0" Text="{Binding StatusDadosBancarios}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Foreground" Value="#77777F"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding DadosBancariosOk}" Value="False">
                                                                                                <Setter Property="Foreground" Value="#CDA656"/>
                                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        <TextBox Grid.Column="1" Text="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CnabRoundedTextBoxStyle}" Margin="10,0,0,0" LostFocus="CnabCriarValorTextBox_LostFocus"/>
                                                                        <TextBox Grid.Column="2" Text="{Binding DataTexto, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataIndividualHabilitada}" Style="{StaticResource CnabRoundedTextBoxStyle}" Margin="10,0,0,0" MaxLength="10" LostFocus="CnabCriarDataTextBox_LostFocus"/>
                                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Button Style="{StaticResource CnabActionIconButtonStyle}" ToolTip="Ver/editar dados bancários" Click="CnabCriarBanco_Click">
                                                                                <Viewbox Width="16" Height="16">
                                                                                    <Canvas Width="24" Height="24">
                                                                                        <Polygon Points="12,3 22,8 2,8" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" Fill="Transparent"/>
                                                                                        <Rectangle Canvas.Left="4" Canvas.Top="10" Width="3" Height="8" RadiusX="0.8" RadiusY="0.8" Stroke="White" StrokeThickness="1.6" Fill="Transparent"/>
                                                                                        <Rectangle Canvas.Left="10.5" Canvas.Top="10" Width="3" Height="8" RadiusX="0.8" RadiusY="0.8" Stroke="White" StrokeThickness="1.6" Fill="Transparent"/>
                                                                                        <Rectangle Canvas.Left="17" Canvas.Top="10" Width="3" Height="8" RadiusX="0.8" RadiusY="0.8" Stroke="White" StrokeThickness="1.6" Fill="Transparent"/>
                                                                                        <Line X1="2" Y1="20" X2="22" Y2="20" Stroke="White" StrokeThickness="1.8"/>
                                                                                        <Line X1="1" Y1="22" X2="23" Y2="22" Stroke="White" StrokeThickness="1.8"/>
                                                                                    </Canvas>
                                                                                </Viewbox>
                                                                            </Button>
                                                                            <Button Style="{StaticResource CnabActionIconButtonStyle}" Foreground="#D56A6A" ToolTip="Excluir pagamento" Click="CnabCriarExcluir_Click">
                                                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="CnabCriarResumoTextBlock" Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock x:Name="CnabCriarAvisoTextBlock" Foreground="#7F7F87" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button x:Name="BtnGerarCnabValeTransporte" Grid.Column="1" Content="Gerar CNAB 240" Style="{StaticResource PrimaryButtonStyle}" Margin="16,0,0,0" Click="CnabCriarSalvar_Click"/>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!-- =================================================== -->
                                <!-- ABA 3: CADASTRO DE COLABORADOR                     -->
                                <!-- =================================================== -->
                                <Grid x:Name="CnabCadastroTabPanel" Grid.Row="3" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            Background="#232329"
                                            BorderThickness="0"
                                            CornerRadius="12"
                                            Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Base de colaboradores"
                                                           Foreground="{DynamicResource TextColor}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Os dados cadastrados aqui são usados automaticamente ao criar o CNAB de Vale Transporte."
                                                           Foreground="#8D8D95"
                                                           FontSize="11"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                                                <Button Content="Ler CNAB base"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Margin="0,0,8,0"
                                                        Padding="4,0"
                                                        ToolTip="Importar ou atualizar colaboradores a partir de um CNAB Santander"
                                                        Click="CnabCadastroImportarBase_Click"/>
                                                <Button Content="Novo colaborador"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Padding="4,0"
                                                        Click="CnabCadastroNovo_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2"
                                            Background="#202022"
                                            BorderThickness="0"
                                            CornerRadius="12"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="42"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="#29292C">
                                                <Grid Margin="12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.5*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="0.7*"/>
                                                        <ColumnDefinition Width="1.0*"/>
                                                        <ColumnDefinition Width="1.25*"/>
                                                        <ColumnDefinition Width="84"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Colaborador" VerticalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="CPF" VerticalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                                    <TextBlock Grid.Column="2" Text="Banco" VerticalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="Agência" VerticalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                                    <TextBlock Grid.Column="4" Text="Conta" VerticalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                                    <TextBlock Grid.Column="5" Text="Ações" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#BDBDC4" FontWeight="SemiBold"/>
                                                </Grid>
                                            </Border>

                                            <ScrollViewer Grid.Row="1"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="CnabCadastroColaboradoresItemsControl">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#242426"
                                                                    BorderBrush="#2F2438"
                                                                    BorderThickness="0,0,0,1"
                                                                    CornerRadius="8"
                                                                    Padding="14,9"
                                                                    Margin="6,2">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2.5*"/>
                                                                        <ColumnDefinition Width="1.25*"/>
                                                                        <ColumnDefinition Width="0.7*"/>
                                                                        <ColumnDefinition Width="1.0*"/>
                                                                        <ColumnDefinition Width="1.25*"/>
                                                                        <ColumnDefinition Width="84"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Nome}"
                                                                                   Foreground="{DynamicResource TextColor}"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding Nome}"/>
                                                                        <TextBlock Text="{Binding DescricaoCadastro}"
                                                                                   Foreground="#77777F"
                                                                                   FontSize="10"
                                                                                   Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DocumentoFormatado}" Foreground="#D5D5DA" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding BancoTexto}" Foreground="#D5D5DA" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding BancoTexto}"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding AgenciaFormatada}" Foreground="#D5D5DA" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding ContaFormatada}" Foreground="#D5D5DA" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Button Style="{StaticResource CnabActionIconButtonStyle}"
                                                                                ToolTip="Editar colaborador"
                                                                                Click="CnabCadastroEditar_Click">
                                                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"/>
                                                                        </Button>
                                                                        <Button Style="{StaticResource CnabActionIconButtonStyle}"
                                                                                Foreground="#D56A6A"
                                                                                ToolTip="Excluir cadastro"
                                                                                Click="CnabCadastroExcluir_Click">
                                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="CnabCadastroResumoTextBlock"
                                                   Foreground="{DynamicResource TextColor}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                        <TextBlock Text="  •  Ler um CNAB mais recente atualiza os dados já cadastrados."
                                                   Foreground="#7F7F87"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>


                            <!-- ============================================ -->
                            <!-- ANALISE DE FATURAS LAYOUT -->
                            <!-- ============================================ -->
                                                        <!-- ============================================ -->
                            <!-- AUX CONCILIAÃ‡ÃƒO -->
                            <!-- ============================================ -->
                            <hfaux:AuxConciliacaoView x:Name="AuxConciliacaoLayout"
                                                      Opacity="0"
                                                      Visibility="Collapsed"
                                                      Margin="40"/>
<Grid x:Name="AnaliseFaturasLayout"
                                  Opacity="0"
                                  Visibility="Collapsed"
                                  Margin="40">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Título -->
                                <TextBlock Grid.Row="0"
                                           Text="Analise de Faturas"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextColor}"/>

                                <!-- Ações -->
                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal">
                                    <Button Content="+  Incluir Análise"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            MinWidth="150"
                                            Padding="16,0"
                                            Click="BtnIncluirAnaliseFatura_Click"/>
                                </StackPanel>

                                <!-- Lista de análises mensais -->
                                <Border Grid.Row="4"
                                        Background="{DynamicResource BackgroundMedium}"
                                        CornerRadius="12"
                                        BorderBrush="#3A3A40"
                                        BorderThickness="1"
                                        Padding="18">
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="AnalisesFaturaItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#252529"
                                                                BorderBrush="#3D3D44"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Margin="0,0,0,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="48"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Button Grid.Column="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        Cursor="Hand"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Click="AbrirHistoricoAnaliseFaturas_Click">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="AbrirCardArea"
                                                                                    Background="Transparent"
                                                                                    CornerRadius="9,0,0,9"
                                                                                    Padding="16,13">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="AbrirCardArea" Property="Background" Value="#2B2830"/>
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed" Value="True">
                                                                                    <Setter TargetName="AbrirCardArea" Property="Opacity" Value="0.82"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="24"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel>
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="{Binding Titulo}"
                                                                                           Foreground="{DynamicResource TextColor}"
                                                                                           FontSize="15"
                                                                                           FontWeight="SemiBold"/>
                                                                                <TextBlock Text="   •   " Foreground="#66666D" FontSize="11" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="{Binding DataAnaliseTexto}"
                                                                                           Foreground="#92929A"
                                                                                           FontSize="11"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding TotaisTexto}"
                                                                                       Foreground="#D0D0D6"
                                                                                       FontSize="12"
                                                                                       Margin="0,7,0,0"/>
                                                                            <TextBlock Text="{Binding ConfiguracoesTexto}"
                                                                                       Foreground="#85858E"
                                                                                       FontSize="10"
                                                                                       Margin="0,4,0,0"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="&#xE76C;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   Foreground="{StaticResource PrimaryColor}"
                                                                                   FontSize="14"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Button>

                                                                <Border Grid.Column="1"
                                                                        BorderBrush="#34343A"
                                                                        BorderThickness="1,0,0,0"
                                                                        Background="Transparent">
                                                                    <Button Style="{StaticResource CnabActionIconButtonStyle}"
                                                                            Foreground="#D56A6A"
                                                                            Width="36"
                                                                            Height="36"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            ToolTip="Excluir análise do histórico"
                                                                            Click="ExcluirHistoricoAnaliseFaturas_Click">
                                                                        <TextBlock Text="&#xE74D;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="17"
                                                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                                                    </Button>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- Estado inicial: lista vazia -->
                                        <StackPanel x:Name="AnalisesFaturaEmptyState"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    MaxWidth="420">
                                            <Border Width="64"
                                                    Height="64"
                                                    CornerRadius="32"
                                                    Background="#2D2635"
                                                    Margin="0,0,0,16">
                                                <TextBlock Text="&#xE8A5;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="28"
                                                           Foreground="{StaticResource PrimaryColor}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Nenhuma análise registrada"
                                                       Foreground="{DynamicResource TextColor}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="As análises concluídas de cada mês aparecerão aqui."
                                                       Foreground="#8E8E96"
                                                       FontSize="12"
                                                       TextAlignment="Center"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            </Grid>
                        </Border>
                    </Grid>
                    

                            
                    
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================ -->
        <!-- INTRO PREMIUM (FICA POR CIMA DE TUDO) -->
        <!-- ============================================ -->
        <Grid x:Name="IntroScreen" Background="Transparent">
            <Border Background="{DynamicResource BackgroundDark}" 
                    CornerRadius="20" 
                    BorderBrush="{DynamicResource BorderColor}" 
                    BorderThickness="1">
                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="IntroScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>

                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center">
                        <TextBlock Text="Hub Financeiro"
                                  Foreground="{DynamicResource TextColor}"
                                  FontSize="32"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"
                                  Effect="{StaticResource DropShadowEffect}"/>
                        
                        <TextBlock Text="Iniciando..."
                                  Foreground="#999999"
                                  FontSize="14"
                                  HorizontalAlignment="Center"
                                  Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    
</Window>
