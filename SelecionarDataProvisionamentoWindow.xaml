<Window x:Class="HubFinanceiro.SelecionarDataProvisionamentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar Data de Provisionamento"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#7920dc"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="TextColor" Color="White"/>
        <SolidColorBrush x:Key="CloseButtonHover" Color="#C42B1C"/>
        
        <!-- Estilo do Botão Fechar -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="0,18,0,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CloseButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{StaticResource BackgroundDark}"
            BorderBrush="{StaticResource PrimaryColor}"
            BorderThickness="1">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>  <!-- Top Bar -->
                <RowDefinition Height="*"/>   <!-- Conteúdo -->
                <RowDefinition Height="Auto"/><!-- Botões -->
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundMedium}"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Título -->
                    <StackPanel Grid.Column="0"
                               Orientation="Horizontal"
                               VerticalAlignment="Center"
                               Margin="25,0,0,0">
                        <TextBlock Text="📅"
                                  FontSize="24"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"/>
                        <TextBlock Text="Selecionar Data de Provisionamento"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextColor}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Botão Fechar -->
                    <Button Grid.Column="1"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="Close_Click">
                        <TextBlock Text="✕" 
                                  FontSize="18" 
                                  FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTEÚDO -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Instrução -->
                <TextBlock Grid.Row="0"
                          Text="Selecione a data de provisionamento que deseja liquidar:"
                          FontSize="14"
                          Foreground="#AAAAAA"
                          Margin="0,0,0,15"
                          TextWrapping="Wrap"/>

                <!-- Lista de Datas -->
                <ScrollViewer Grid.Row="1"
                             VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DatasItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundMedium}"
                                       CornerRadius="10"
                                       Padding="20,15"
                                       Margin="0,0,0,10"
                                       Cursor="Hand"
                                       MouseLeftButtonDown="DataItem_Click"
                                       Tag="{Binding}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Ícone -->
                                        <TextBlock Grid.Column="0"
                                                  Text="📅"
                                                  FontSize="32"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,20,0"/>

                                        <!-- Informações -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="18"
                                                      FontWeight="Bold"
                                                      Foreground="{StaticResource TextColor}">
                                                <Run Text="Provisionado para "/>
                                                <Run Text="{Binding DataFormatada, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="13"
                                                      Foreground="#AAAAAA"
                                                      Margin="0,5,0,0">
                                                <Run Text="{Binding Quantidade, Mode=OneWay}"/>
                                                <Run Text=" pagamento(s) • Total: R$ "/>
                                                <Run Text="{Binding TotalFormatado, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Seta -->
                                        <TextBlock Grid.Column="2"
                                                  Text="›"
                                                  FontSize="32"
                                                  Foreground="{StaticResource PrimaryColor}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- BOTÕES -->
            <Grid Grid.Row="2" Margin="25,0,25,25">
                <Button Content="Cancelar"
                        Height="45"
                        Background="{StaticResource BackgroundMedium}"
                        Foreground="{StaticResource TextColor}"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="Cancelar_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BackgroundLight}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
