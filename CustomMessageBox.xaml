<Window x:Class="HubFinanceiro.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hub Financeiro"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="450"
        MaxWidth="700"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Cores do Tema -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#7920dc"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#5e17aa"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2D2D30"/>
        <SolidColorBrush x:Key="AccentColor" Color="#633884"/>
        <SolidColorBrush x:Key="TextColor" Color="White"/>
        
        <!-- Estilo dos Botões -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4a0f88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo do Botão Cancelar -->
        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="15,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15"
            Background="{DynamicResource BackgroundDark}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1">
        
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título com Ícone -->
            <StackPanel Grid.Row="0" 
                       Orientation="Horizontal"
                       Margin="0,0,0,15">
                <TextBlock x:Name="IconTextBlock"
                          Text="⚠"
                          FontSize="24"
                          Foreground="#FFA500"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleTextBlock"
                          Text="Aviso"
                          FontSize="18"
                          FontWeight="Bold"
                          Foreground="{DynamicResource TextColor}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Mensagem -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BackgroundMedium}"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,20"
                    MaxWidth="650">
                <StackPanel x:Name="MessagePanel" VerticalAlignment="Center">
                    <TextBlock x:Name="MessageTextBlock"
                              Text="Mensagem aqui"
                              FontSize="14"
                              Foreground="{DynamicResource TextColor}"
                              TextWrapping="Wrap"
                              TextAlignment="Left"
                              LineHeight="20"
                              MaxWidth="620"/>
                    <TextBlock x:Name="MessageDetailTextBlock"
                              FontSize="15"
                              Foreground="{StaticResource PrimaryColor}"
                              FontWeight="Bold"
                              TextWrapping="Wrap"
                              TextAlignment="Left"
                              Margin="0,10,0,0"
                              MaxWidth="620"
                              Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Botões -->
            <StackPanel Grid.Row="2"
                       Orientation="Horizontal"
                       HorizontalAlignment="Right">
                <Button x:Name="YesButton"
                       Content="Sim"
                       Style="{StaticResource DialogButtonStyle}"
                       Click="YesButton_Click"
                       Visibility="Collapsed"/>
                <Button x:Name="NoButton"
                       Content="Não"
                       Style="{StaticResource CancelButtonStyle}"
                       Click="NoButton_Click"
                       Visibility="Collapsed"/>
                <Button x:Name="OkButton"
                       Content="OK"
                       Style="{StaticResource DialogButtonStyle}"
                       Click="OkButton_Click"
                       Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
