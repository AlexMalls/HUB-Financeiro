<Window x:Class="HubFinanceiro.InfosPositivaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Infos Positiva"
        Width="1000"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="White">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#151517"/>
        <SolidColorBrush x:Key="Surface" Color="#202024"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#29292E"/>
        <SolidColorBrush x:Key="Border" Color="#393940"/>
        <SolidColorBrush x:Key="Accent" Color="#7920DC"/>
        <SolidColorBrush x:Key="Green" Color="#55D98A"/>
        <SolidColorBrush x:Key="Amber" Color="#F2B84B"/>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8F8F98"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}"
            BorderBrush="#45454E"
            BorderThickness="1"
            CornerRadius="13">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#1B1B1F"
                    BorderBrush="#303036"
                    BorderThickness="0,0,0,1"
                    CornerRadius="13,13,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#2B1741" Margin="0,0,11,0">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#B66BFF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Infos Positiva" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Consulta rápida corporativa e bancária" Foreground="#8F8F98" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="34" Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#AFAFB6"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Content=""
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,20,22,24">
                    <StackPanel Margin="2,0,2,17">
                        <TextBlock Text="Informações essenciais" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock Text="Dados de referência para o dia a dia financeiro da Positiva."
                                   Foreground="#9B9BA3" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Background="#1C2923" BorderBrush="#315441" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#254332" Margin="0,0,11,0">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Green}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="PIX" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Condição válida para Administradora e Corretora" Foreground="#9BB5A6" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" Background="#254332" CornerRadius="13" Padding="12,5" VerticalAlignment="Center">
                                <TextBlock Text="Tarifa isenta" Foreground="{StaticResource Green}" FontWeight="SemiBold" FontSize="11"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ADMINISTRADORA" Foreground="#B66BFF" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Positiva Administradora de Benefícios Ltda" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,5,8,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#2B1741" CornerRadius="8" Padding="8,5" VerticalAlignment="Top">
                                        <TextBlock Text="ADM" Foreground="#C996FF" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="CNPJ" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="25.006.061/0001-97" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="25006061000197" Foreground="#7F7F88" FontFamily="Consolas" FontSize="10" Margin="0,2,0,13"/>

                                <Border Height="1" Background="#333339" Margin="0,0,0,13"/>

                                <TextBlock Text="BANCO" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Santander  •  código 033" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="Convênio 0033-3409-004902845301" Foreground="#9B9BA3" FontSize="10" Margin="0,3,0,14"/>

                                <TextBlock Text="TARIFAS E SERVIÇOS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                <TextBlock Text="• Emissão de boleto  —  R$ 0,99 por boleto" FontSize="11" Margin="0,0,0,6"/>
                                <TextBlock Text="• Liquidação de boleto  —  Isenta" FontSize="11" Margin="0,0,0,6"/>
                                <TextBlock Text="• Baixa de boleto  —  Isenta" FontSize="11" Margin="0,0,0,6"/>
                                <TextBlock Text="• Manutenção de título vencido  —  R$ 1,85 por título" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="• Débito automático  —  R$ 3,35" FontSize="11" Margin="0,0,0,6"/>
                                <TextBlock Text="• PIX no corpo do boleto  —  disponível para ativação" FontSize="11" TextWrapping="Wrap"/>

                                <Border Background="#332B1E" BorderBrush="#55472C" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,15,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SUPERFOLHAONLINE" Foreground="{StaticResource Amber}" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text="Implementação sem custo" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock Text="Ainda não implantado" Foreground="#D1B77C" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CORRETORA" Foreground="#72B7FF" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="Positiva Corretora de Seguros Ltda" Style="{StaticResource CardTitle}" TextWrapping="Wrap" Margin="0,5,8,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#172C41" CornerRadius="8" Padding="8,5" VerticalAlignment="Top">
                                        <TextBlock Text="COR" Foreground="#86C2FF" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="CNPJ" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="28.929.873/0001-00" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="28929873000100" Foreground="#7F7F88" FontFamily="Consolas" FontSize="10" Margin="0,2,0,13"/>

                                <Border Height="1" Background="#333339" Margin="0,0,0,13"/>

                                <TextBlock Text="BANCO" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Santander  •  código 033" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="Convênio 0033-4268-004905078983" Foreground="#9B9BA3" FontSize="10" Margin="0,3,0,14"/>

                                <TextBlock Text="CONDIÇÕES" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                <TextBlock Text="• Tarifa de PIX  —  Isenta" FontSize="11"/>
                                <TextBlock Text="As demais tarifas listadas para boletos e débito automático são condições específicas da Administradora."
                                           Foreground="#8F8F98" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/>

                                <Border Background="#1C2923" BorderBrush="#315441" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,15,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SUPERFOLHAONLINE" Foreground="{StaticResource Green}" FontSize="9" FontWeight="Bold"/>
                                        <TextBlock Text="Implantado" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock Text="Operação disponível na Corretora" Foreground="#9BB5A6" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="ENDEREÇOS" Style="{StaticResource SectionLabel}" Margin="2,19,0,9"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource SurfaceAlt}" CornerRadius="9" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Rio de Janeiro" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Rua Debret, 79 – Centro – Rio de Janeiro/RJ – CEP 20030-080" Foreground="#A5A5AD" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceAlt}" CornerRadius="9" Padding="14">
                            <StackPanel>
                                <TextBlock Text="São Paulo" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="Alameda Campinas, 457 – Jardim Paulista – São Paulo/SP – CEP 01404-100" Foreground="#A5A5AD" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
