<Application x:Class="HubFinanceiro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Recursos Dinâmicos de Tema -->
        <SolidColorBrush x:Key="AppBackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="AppBackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="AppBackgroundLight" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="AppTextColor" Color="White"/>
        <SolidColorBrush x:Key="AppBorderColor" Color="#2D2D30"/>
        <!-- Recurso visual compartilhado por janelas de diagnóstico/histórico -->
        <SolidColorBrush x:Key="SurfaceHoverColor" Color="#2D2733"/>
    </Application.Resources>
</Application>
