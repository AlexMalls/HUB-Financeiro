<Window x:Class="HubFinanceiro.MovimentacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movimentar Registros"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Width="500"
        Height="530"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#7920dc"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#5e17aa"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="TextColor" Color="White"/>
        <SolidColorBrush x:Key="CloseButtonHover" Color="#C42B1C"/>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{StaticResource BackgroundDark}"
            BorderBrush="{StaticResource PrimaryColor}"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra Superior -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundLight}"
                    Padding="2"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Border Background="{StaticResource BackgroundMedium}"
                        CornerRadius="18,18,0,0">
                    <Grid>
                        <TextBlock Text="Movimentar Registros"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"
                                   Foreground="{StaticResource TextColor}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <Button Content="✕"
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                Foreground="{StaticResource TextColor}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Close_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="0,18,0,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CloseButtonHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Border>

            <!-- Conteúdo -->
            <StackPanel Grid.Row="1" Margin="30,30,30,30">
                <TextBlock Text="Selecione o tipo de movimentação:"
                          Foreground="{StaticResource TextColor}"
                          FontSize="16"
                          FontWeight="SemiBold"
                          Margin="0,0,0,25"
                          HorizontalAlignment="Center"/>

                <!-- Botão Provisionar -->
                <Border BorderBrush="#666666"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,15"
                        Margin="0,0,0,15"
                        Cursor="Hand"
                        MouseLeftButtonDown="Provisionar_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
                            <Setter Property="BorderBrush" Value="#666666"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3A3A3D"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Text="📋 Provisionar Pagamentos"
                                  Foreground="{StaticResource TextColor}"
                                  FontSize="16"
                                  FontWeight="Bold"/>
                        <TextBlock Text="Criar provisionamento de pagamentos futuros"
                                  Foreground="#999999"
                                  FontSize="12"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Botão Desprovisionar -->
                <Border BorderBrush="#666666"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,15"
                        Margin="0,0,0,15"
                        Cursor="Hand"
                        MouseLeftButtonDown="Desprovisionar_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
                            <Setter Property="BorderBrush" Value="#666666"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3A3A3D"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Text="↩ Desprovisionar Pagamento"
                                  Foreground="{StaticResource TextColor}"
                                  FontSize="16"
                                  FontWeight="Bold"/>
                        <TextBlock Text="Reverter pagamentos provisionados para pendente"
                                  Foreground="#999999"
                                  FontSize="12"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Botão Liquidar -->
                <Border BorderBrush="#666666"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,15"
                        Margin="0,0,0,15"
                        Cursor="Hand"
                        MouseLeftButtonDown="Liquidar_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
                            <Setter Property="BorderBrush" Value="#666666"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3A3A3D"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Text="✅ Liquidar Pagamentos"
                                  Foreground="{StaticResource TextColor}"
                                  FontSize="16"
                                  FontWeight="Bold"/>
                        <TextBlock Text="Confirmar pagamentos realizados"
                                  Foreground="#999999"
                                  FontSize="12"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Botão Relatório -->
                <Border BorderBrush="#666666"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20,15"
                        Cursor="Hand"
                        MouseLeftButtonDown="Relatorio_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
                            <Setter Property="BorderBrush" Value="#666666"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#3A3A3D"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel IsHitTestVisible="False">
                        <TextBlock Text="📊 Relatório de Pagamentos"
                                  Foreground="{StaticResource TextColor}"
                                  FontSize="16"
                                  FontWeight="Bold"/>
                        <TextBlock Text="Gerar relatório completo de pagamentos"
                                  Foreground="#999999"
                                  FontSize="12"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
