<Window x:Class="HubFinanceiro.SobreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre"
        Width="650"
        Height="610"
        MinWidth="580"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="White">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#151517"/>
        <SolidColorBrush x:Key="Surface" Color="#202024"/>
        <SolidColorBrush x:Key="Border" Color="#393940"/>
    </Window.Resources>

    <Border Background="{StaticResource Bg}"
            BorderBrush="#45454E"
            BorderThickness="1"
            CornerRadius="13">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#1B1B1F"
                    BorderBrush="#303036"
                    BorderThickness="0,0,0,1"
                    CornerRadius="13,13,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Sobre" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Width="34" Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#AFAFB6"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Content=""
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="35,29,35,30">
                    <!-- Logo vetorizada a partir do arquivo oficial da Ennoia.
                         Evita a decodificação do PNG indexado que gerava artefatos no WPF. -->
                    <Viewbox Width="124"
                             Height="124"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,10">
                        <Path Width="902"
                              Height="902"
                              Stretch="Uniform"
                              FillRule="EvenOdd"
                              Data="M 477,419 L 473,421 L 409,487 L 405,493 L 405,497 L 416,510 L 475,570 L 481,570 L 551,499 L 552,493 L 550,489 L 484,421 Z M 511,17 L 460,16 L 435,18 L 396,24 L 350,36 L 315,49 L 276,68 L 243,88 L 206,116 L 166,154 L 146,177 L 118,216 L 97,252 L 81,286 L 67,324 L 55,370 L 49,407 L 46,460 L 48,495 L 53,530 L 63,574 L 73,605 L 87,639 L 106,676 L 136,721 L 159,749 L 191,781 L 226,809 L 258,830 L 296,850 L 325,862 L 377,877 L 406,882 L 440,885 L 465,885 L 500,882 L 533,876 L 562,868 L 599,854 L 637,835 L 660,821 L 684,804 L 706,786 L 728,765 L 756,733 L 768,717 L 792,679 L 807,649 L 818,616 L 817,598 L 813,585 L 807,574 L 796,562 L 781,553 L 770,550 L 750,550 L 743,552 L 729,559 L 714,574 L 706,588 L 702,600 L 689,625 L 679,641 L 659,667 L 636,691 L 604,717 L 580,732 L 560,742 L 521,756 L 499,761 L 475,764 L 432,764 L 397,759 L 359,748 L 324,732 L 301,718 L 278,701 L 260,685 L 241,665 L 218,635 L 202,609 L 188,580 L 176,547 L 168,513 L 164,482 L 163,451 L 167,405 L 174,371 L 182,345 L 192,320 L 208,289 L 225,263 L 247,236 L 268,215 L 301,189 L 334,169 L 365,155 L 382,149 L 414,141 L 454,136 L 497,136 L 518,138 L 546,143 L 575,151 L 609,165 L 631,177 L 655,193 L 674,208 L 702,236 L 726,268 L 731,281 L 733,293 L 733,301 L 730,314 L 726,322 L 718,332 L 705,341 L 691,345 L 679,345 L 666,342 L 656,337 L 608,296 L 581,279 L 564,271 L 542,263 L 515,257 L 488,254 L 472,254 L 435,259 L 401,270 L 368,287 L 351,299 L 336,312 L 316,334 L 302,354 L 289,378 L 282,395 L 274,423 L 271,443 L 272,487 L 278,515 L 284,532 L 295,555 L 305,571 L 318,587 L 340,608 L 358,621 L 376,631 L 390,637 L 413,644 L 441,648 L 485,647 L 490,644 L 493,638 L 491,632 L 484,627 L 462,626 L 439,621 L 428,617 L 404,604 L 389,592 L 372,573 L 363,559 L 352,533 L 347,509 L 347,479 L 349,465 L 354,448 L 363,428 L 380,404 L 396,389 L 414,377 L 441,366 L 461,362 L 492,362 L 513,366 L 530,372 L 556,387 L 589,420 L 603,431 L 621,442 L 639,450 L 659,456 L 676,459 L 696,460 L 715,458 L 741,451 L 759,443 L 777,432 L 809,404 L 826,383 L 835,368 L 849,334 L 854,309 L 855,285 L 851,254 L 845,234 L 834,211 L 818,187 L 792,155 L 761,124 L 729,98 L 689,72 L 660,57 L 622,41 L 587,30 L 551,22 Z">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6E13B7" Offset="0.00"/>
                                    <GradientStop Color="#7A1EA7" Offset="0.20"/>
                                    <GradientStop Color="#882B94" Offset="0.40"/>
                                    <GradientStop Color="#943683" Offset="0.60"/>
                                    <GradientStop Color="#A14272" Offset="0.80"/>
                                    <GradientStop Color="#D87526" Offset="1.00"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Viewbox>

                    <TextBlock Text="ENNOIA"
                               HorizontalAlignment="Center"
                               FontSize="25"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="HUB Financeiro"
                               HorizontalAlignment="Center"
                               Foreground="#B66BFF"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                    <TextBlock x:Name="VersionText"
                               Text="Versão"
                               HorizontalAlignment="Center"
                               Foreground="#777780"
                               FontSize="10"
                               Margin="0,3,0,22"/>

                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Um projeto Ennoia" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="O HUB Financeiro é um projeto desenvolvido e mantido pela Ennoia, criado para centralizar, apoiar e evoluir rotinas financeiras em um único ambiente."
                                       Foreground="#B3B3BA"
                                       FontSize="12"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       Margin="0,9,0,0"/>
                            <TextBlock Text="Sua proposta é transformar processos recorrentes em fluxos mais claros, organizados e consistentes, mantendo as ferramentas do dia a dia próximas de quem realmente as utiliza."
                                       Foreground="#8F8F98"
                                       FontSize="11"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1B1B1F" CornerRadius="9" Padding="14">
                            <StackPanel>
                                <TextBlock Text="PRODUTO" Foreground="#777780" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="HUB Financeiro" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="Aplicação desktop para suporte às rotinas financeiras" Foreground="#909099" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#1B1B1F" CornerRadius="9" Padding="14">
                            <StackPanel>
                                <TextBlock Text="DESENVOLVIMENTO" Foreground="#777780" FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="Ennoia" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="Concepção, desenvolvimento e evolução do projeto" Foreground="#909099" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="#303036" Margin="0,24,0,18"/>

                    <TextBlock Text="© 2026 Ennoia. Todos os direitos reservados."
                               HorizontalAlignment="Center"
                               Foreground="#9A9AA2"
                               FontSize="10"/>
                    <TextBlock Text="Este software, sua interface e seus componentes integram o projeto HUB Financeiro da Ennoia."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#686871"
                               FontSize="9"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
