<Window x:Class="HubFinanceiro.SelecionarDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selecionar Data de Provisionamento"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Width="500"
        Height="250"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Cores -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#7920dc"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#5e17aa"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="TextColor" Color="White"/>
        <SolidColorBrush x:Key="CloseButtonHover" Color="#C42B1C"/>
        
        <!-- Estilo do botão fechar -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="0,15,0,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CloseButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo botão primário -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryHoverColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo botão secundário -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BackgroundMedium}"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3A3A3D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A2D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15"
            Background="{StaticResource BackgroundDark}"
            BorderBrush="{StaticResource PrimaryColor}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra Superior -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundMedium}"
                    CornerRadius="15,15,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="TitleTextBlock"
                              Text="Selecionar Data de Provisionamento"
                              Foreground="{StaticResource TextColor}"
                              FontSize="13"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="15,0"/>
                    
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Click="Close_Click"
                            Style="{StaticResource CloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Conteúdo -->
            <StackPanel Grid.Row="1"
                       Margin="30"
                       VerticalAlignment="Center">
                
                <TextBlock x:Name="PromptTextBlock"
                          Text="Para qual data deseja provisionar os pagamentos?"
                          Foreground="{StaticResource TextColor}"
                          FontSize="14"
                          Margin="0,0,0,20"
                          TextWrapping="Wrap"/>
                
                <!-- Campo de Data -->
                <Border Background="{StaticResource BackgroundMedium}"
                        CornerRadius="6"
                        Height="45"
                        Margin="0,0,0,25">
                    <TextBox x:Name="DataTextBox"
                            Background="Transparent"
                            Foreground="{StaticResource TextColor}"
                            BorderThickness="0"
                            Padding="15,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            VerticalContentAlignment="Center"
                            CaretBrush="{StaticResource PrimaryColor}"
                            MaxLength="10"
                            PreviewTextInput="DataTextBox_PreviewTextInput"
                            TextChanged="DataTextBox_TextChanged"
                            PreviewKeyDown="DataTextBox_PreviewKeyDown">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Border>
                
                <!-- Botões -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0"
                            Content="Cancelar"
                            Height="40"
                            Click="Cancelar_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    
                    <Button x:Name="ActionButton"
                            Grid.Column="2"
                            Content="Provisionar"
                            Height="40"
                            Click="Provisionar_Click"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
