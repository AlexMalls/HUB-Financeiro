<Window x:Class="HubFinanceiro.LiquidacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liquidação de Pagamentos"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        Width="1100"
        Height="650"
        MinWidth="900"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#7920dc"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#2A2A2D"/>
        <SolidColorBrush x:Key="TextColor" Color="White"/>
        <SolidColorBrush x:Key="CloseButtonHover" Color="#C42B1C"/>
        
        <!-- Estilo do Botão Fechar -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="0,18,0,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CloseButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{StaticResource BackgroundDark}"
            BorderBrush="{StaticResource PrimaryColor}"
            BorderThickness="1">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>  <!-- Top Bar -->
                <RowDefinition Height="*"/>   <!-- Conteúdo -->
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundMedium}"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Título -->
                    <StackPanel Grid.Column="0"
                               Orientation="Horizontal"
                               VerticalAlignment="Center"
                               Margin="25,0,0,0">
                        <TextBlock Text="💰"
                                  FontSize="24"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"/>
                        <TextBlock Text="Liquidação de Pagamentos"
                                  FontSize="18"
                                  FontWeight="SemiBold"
                                  Foreground="{StaticResource TextColor}"
                                  VerticalAlignment="Center"/>
                        <TextBlock x:Name="DataProvisionamentoTextBlock"
                                  FontSize="14"
                                  FontWeight="Normal"
                                  Foreground="{StaticResource PrimaryColor}"
                                  VerticalAlignment="Center"
                                  Margin="15,0,0,0"/>
                    </StackPanel>

                    <!-- Botão Fechar -->
                    <Button Grid.Column="1"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="Close_Click">
                        <TextBlock Text="✕" 
                                  FontSize="18" 
                                  FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTEÚDO -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>      <!-- Listas -->
                    <RowDefinition Height="Auto"/>   <!-- Totais -->
                    <RowDefinition Height="Auto"/>   <!-- Botão -->
                </Grid.RowDefinitions>

                <!-- LISTAS ADM E CORRETORA -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ADMINISTRADORA -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BackgroundMedium}"
                            CornerRadius="12"
                            BorderBrush="#4CAF50"
                            BorderThickness="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho ADM -->
                            <Border Grid.Row="0"
                                   Background="#4CAF50"
                                   CornerRadius="10,10,0,0"
                                   Padding="15,12">
                                <TextBlock Text="🏢 ADMINISTRADORA"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          Foreground="White"
                                          HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Lista ADM -->
                            <ScrollViewer Grid.Row="1"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="10">
                                <ItemsControl x:Name="AdministradoraItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BackgroundLight}"
                                                   CornerRadius="8"
                                                   Padding="12"
                                                   Margin="0,0,0,8"
                                                   MouseLeftButtonDown="ItemAdm_MouseLeftButtonDown"
                                                   Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding NomeFornecedor}"
                                                                  FontSize="14"
                                                                  FontWeight="SemiBold"
                                                                  Foreground="{StaticResource TextColor}"/>
                                                        <TextBlock FontSize="12"
                                                                  Foreground="#AAAAAA"
                                                                  Margin="0,4,0,0">
                                                            <Run Text="Natureza: "/>
                                                            <Run Text="{Binding Natureza}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                              FontSize="16"
                                                              FontWeight="Bold"
                                                              Foreground="#4CAF50"
                                                              VerticalAlignment="Center"
                                                              Margin="10,0,0,0">
                                                        <Run Text="R$ "/>
                                                        <Run Text="{Binding Valor, StringFormat=N2}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- CORRETORA -->
                    <Border Grid.Column="2"
                            Background="{StaticResource BackgroundMedium}"
                            CornerRadius="12"
                            BorderBrush="#2196F3"
                            BorderThickness="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Cabeçalho COR -->
                            <Border Grid.Row="0"
                                   Background="#2196F3"
                                   CornerRadius="10,10,0,0"
                                   Padding="15,12">
                                <TextBlock Text="🏪 CORRETORA"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          Foreground="White"
                                          HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Lista COR -->
                            <ScrollViewer Grid.Row="1"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="10">
                                <ItemsControl x:Name="CorretoraItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BackgroundLight}"
                                                   CornerRadius="8"
                                                   Padding="12"
                                                   Margin="0,0,0,8"
                                                   MouseLeftButtonDown="ItemCor_MouseLeftButtonDown"
                                                   Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding NomeFornecedor}"
                                                                  FontSize="14"
                                                                  FontWeight="SemiBold"
                                                                  Foreground="{StaticResource TextColor}"/>
                                                        <TextBlock FontSize="12"
                                                                  Foreground="#AAAAAA"
                                                                  Margin="0,4,0,0">
                                                            <Run Text="Natureza: "/>
                                                            <Run Text="{Binding Natureza}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                              FontSize="16"
                                                              FontWeight="Bold"
                                                              Foreground="#2196F3"
                                                              VerticalAlignment="Center"
                                                              Margin="10,0,0,0">
                                                        <Run Text="R$ "/>
                                                        <Run Text="{Binding Valor, StringFormat=N2}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TOTAIS -->
                <Grid Grid.Row="1" Margin="0,15,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total ADM -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BackgroundMedium}"
                            CornerRadius="8"
                            Padding="15"
                            BorderBrush="#4CAF50"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                      Text="💰"
                                      FontSize="20"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Total Administradora"
                                          FontSize="12"
                                          Foreground="#AAAAAA"/>
                                <TextBlock x:Name="TotalAdmTextBlock"
                                          Text="R$ 0,00"
                                          FontSize="18"
                                          FontWeight="Bold"
                                          Foreground="#4CAF50"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                      x:Name="QuantAdmTextBlock"
                                      Text="0"
                                      FontSize="24"
                                      FontWeight="Bold"
                                      Foreground="#4CAF50"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Total COR -->
                    <Border Grid.Column="2"
                            Background="{StaticResource BackgroundMedium}"
                            CornerRadius="8"
                            Padding="15"
                            BorderBrush="#2196F3"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                      Text="💰"
                                      FontSize="20"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Total Corretora"
                                          FontSize="12"
                                          Foreground="#AAAAAA"/>
                                <TextBlock x:Name="TotalCorTextBlock"
                                          Text="R$ 0,00"
                                          FontSize="18"
                                          FontWeight="Bold"
                                          Foreground="#2196F3"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                      x:Name="QuantCorTextBlock"
                                      Text="0"
                                      FontSize="24"
                                      FontWeight="Bold"
                                      Foreground="#2196F3"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- BOTÃO LIQUIDAR -->
                <Button Grid.Row="2"
                        x:Name="BtnLiquidar"
                        Height="50"
                        Background="{StaticResource PrimaryColor}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="16"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="Liquidar_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               CornerRadius="10"
                                               Padding="20,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#9140f0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓ " FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Text="Liquidar Pagamentos" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
