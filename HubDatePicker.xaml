<UserControl x:Class="HubFinanceiro.HubDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="38">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HubDatePrimary" Color="#7920DC"/>
        <SolidColorBrush x:Key="HubDatePrimaryHover" Color="#5E17AA"/>
        <SolidColorBrush x:Key="HubDateAccent" Color="#633884"/>
        <SolidColorBrush x:Key="HubDateSurface" Color="#252526"/>
        <SolidColorBrush x:Key="HubDateSurfaceHover" Color="#303036"/>
        <SolidColorBrush x:Key="HubDateSurfacePressed" Color="#372A42"/>
        <SolidColorBrush x:Key="HubDateBorder" Color="#3B3B42"/>
        <SolidColorBrush x:Key="HubDateText" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="HubDateMutedText" Color="#9B9BA3"/>

        <Style x:Key="HubDateInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource HubDateText}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{StaticResource HubDatePrimary}"/>
            <Setter Property="SelectionOpacity" Value="0.45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="11,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="HubDateIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource HubDateMutedText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Margin="2"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource HubDateSurfaceHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource HubDateSurfacePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HubCalendarNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource HubDateText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="{StaticResource HubDateSurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="{StaticResource HubDateSurfacePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HubCalendarDayButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource HubDateText}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DaySurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DaySurface" Property="Background" Value="{StaticResource HubDateSurfaceHover}"/>
                                <Setter TargetName="DaySurface" Property="BorderBrush" Value="{StaticResource HubDateAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DaySurface" Property="Background" Value="{StaticResource HubDateSurfacePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="InputBorder"
                Height="38"
                Background="{StaticResource HubDateSurface}"
                BorderBrush="{StaticResource HubDateBorder}"
                BorderThickness="1"
                CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="DateTextBox"
                         Grid.Column="0"
                         Style="{StaticResource HubDateInputStyle}"
                         MaxLength="10"
                         ToolTip="dd/mm/aaaa"
                         PreviewTextInput="DateTextBox_PreviewTextInput"
                         LostKeyboardFocus="DateTextBox_LostKeyboardFocus"
                         KeyDown="DateTextBox_KeyDown"
                         GotKeyboardFocus="DateTextBox_GotKeyboardFocus"/>

                <Border Grid.Column="1"
                        Width="1"
                        Height="22"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{StaticResource HubDateBorder}"/>

                <Button Grid.Column="1"
                        Style="{StaticResource HubDateIconButtonStyle}"
                        ToolTip="Abrir calendário"
                        Click="CalendarButton_Click">
                    <TextBlock Text="&#xE787;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>
        </Border>

        <Popup x:Name="CalendarPopup"
               PlacementTarget="{Binding ElementName=InputBorder}"
               Placement="Bottom"
               VerticalOffset="6"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="CalendarPopup_Opened">
            <Border Width="294"
                    Padding="12"
                    Background="#232324"
                    BorderBrush="{StaticResource HubDateAccent}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16"
                                      ShadowDepth="4"
                                      Opacity="0.48"
                                      Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="204"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource HubCalendarNavButtonStyle}"
                                ToolTip="Mês anterior"
                                Click="MesAnterior_Click">
                            <TextBlock Text="&#xE76B;"
                                       FontFamily="Segoe MDL2 Assets"/>
                        </Button>

                        <TextBlock x:Name="MesAnoTextBlock"
                                   Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource HubDateText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource HubCalendarNavButtonStyle}"
                                ToolTip="Próximo mês"
                                Click="ProximoMes_Click">
                            <TextBlock Text="&#xE76C;"
                                       FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="7">
                        <TextBlock Text="D" Foreground="{StaticResource HubDateMutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="S" Foreground="{StaticResource HubDateMutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="T" Foreground="{StaticResource HubDateMutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="Q" Foreground="{StaticResource HubDateMutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="Q" Foreground="{StaticResource HubDateMutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="S" Foreground="{StaticResource HubDateMutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="S" Foreground="{StaticResource HubDateMutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                    </UniformGrid>

                    <UniformGrid x:Name="DiasUniformGrid"
                                 Grid.Row="2"
                                 Columns="7"
                                 Rows="6"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
