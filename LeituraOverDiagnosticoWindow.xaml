<Window x:Class="HubFinanceiro.LeituraOverDiagnosticoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HubFinanceiro"
        Title="Leitura estruturada do Over"
        WindowStyle="None"
        ResizeMode="CanResize"
        MinWidth="1040"
        MinHeight="620"
        Width="1320"
        Height="760"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#7920dc"/>
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#5e17aa"/>
        <SolidColorBrush x:Key="BackgroundDark" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="BackgroundMedium" Color="#252526"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#202024"/>
        <SolidColorBrush x:Key="SurfaceHoverColor" Color="#2D2733"/>
        <SolidColorBrush x:Key="SurfaceSelectedColor" Color="#39264A"/>
        <SolidColorBrush x:Key="MutedTextColor" Color="#96969F"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3B3B41"/>
        <SolidColorBrush x:Key="GridBorderColor" Color="#3A3A40"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#70D6A0"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F2C879"/>
        <SolidColorBrush x:Key="CloseButtonHover" Color="#C42B1C"/>
        <SolidColorBrush x:Key="ScrollbarColor" Color="#6E6E6E"/>
        <SolidColorBrush x:Key="SelectionPurple" Color="#7A3FA0"/>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="Transparent">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="{StaticResource ScrollbarColor}"
                                                        CornerRadius="4"
                                                        Margin="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#8A6AA0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="8"/>
                                <Setter Property="Height" Value="Auto"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#343438"/>
            <Setter Property="BorderBrush" Value="#515158"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#403747"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#684A7E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#342C3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HubTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionPurple}"/>
            <Setter Property="SelectionOpacity" Value="0.75"/>
            <Setter Property="BorderBrush" Value="#494950"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#684A7E"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="InputBorder" Property="Background" Value="#242027"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#262629"/>
            <Setter Property="Foreground" Value="#E2E2E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource GridBorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DEDEE4"/>
            <Setter Property="BorderBrush" Value="{StaticResource GridBorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="{StaticResource SurfaceSelectedColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#222224"/>
            <Setter Property="Foreground" Value="#DEDEE4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#252528"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceHoverColor}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceSelectedColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18"
            Background="{StaticResource BackgroundDark}"
            BorderBrush="{StaticResource PrimaryColor}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundMedium}"
                    CornerRadius="18,18,0,0"
                    MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Diagnóstico — leitura estruturada do Over"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <Button Content="✕"
                            Width="42"
                            Height="42"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="0,18,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBorder" Property="Background" Value="{StaticResource CloseButtonHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Leitura — relatório Over"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="Bold"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Arquivo"
                                   Foreground="#BEBEC5"
                                   FontSize="11"
                                   Margin="0,0,0,5"/>
                        <Border Height="36"
                                Background="{StaticResource SurfaceColor}"
                                BorderBrush="#494950"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="11,0">
                            <TextBlock x:Name="ArquivoText"
                                       VerticalAlignment="Center"
                                       Foreground="#DEDEE4"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Pesquisar beneficiário, certif. normalizado, cartão, matrícula, evento ou entidade"
                                   Foreground="#BEBEC5"
                                   FontSize="11"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="PesquisaTextBox"
                                 Height="36"
                                 Style="{StaticResource HubTextBoxStyle}"
                                 TextChanged="PesquisaTextBox_TextChanged"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="4"
                        Background="{StaticResource BackgroundMedium}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ResumoText"
                                       Foreground="{StaticResource SuccessColor}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetalhesText"
                                       Foreground="{StaticResource MutedTextColor}"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="FiltroResultadoText"
                                   Grid.Column="1"
                                   Foreground="#BEBEC5"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="18,0,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="6"
                        Background="{StaticResource SurfaceColor}"
                        BorderBrush="#44444B"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <DataGrid x:Name="LancamentosDataGrid"
                              local:DataGridCopiavelBehavior.Habilitado="True"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="True"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              AlternationCount="2"
                              RowHeight="30"
                              ColumnHeaderHeight="32"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              Background="{StaticResource SurfaceColor}"
                              Foreground="#DEDEE4"
                              HorizontalGridLinesBrush="{StaticResource GridBorderColor}"
                              VerticalGridLinesBrush="{StaticResource GridBorderColor}"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              SelectionMode="Extended"
                              SelectionUnit="Cell"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Linha" Binding="{Binding Linha}" Width="68"/>
                            <DataGridTextColumn Header="Período" Binding="{Binding Periodo}" Width="82"/>
                            <DataGridTextColumn Header="Operadora" Binding="{Binding Operadora}" Width="170"/>
                            <DataGridTextColumn Header="Entidade" Binding="{Binding Entidade}" Width="105"/>
                            <DataGridTextColumn Header="Apólice" Binding="{Binding Apolice}" Width="78"/>
                            <DataGridTextColumn Header="Matrícula" Binding="{Binding Matricula}" Width="150"/>
                            <DataGridTextColumn Header="Beneficiário" Binding="{Binding Beneficiario}" Width="250"/>
                            <DataGridTextColumn Header="Evento" Binding="{Binding Evento}" Width="72"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="280"/>
                            <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="130"/>
                            <DataGridTextColumn Header="Valor PV" Binding="{Binding ValorPV}" Width="95"/>
                            <DataGridTextColumn Header="Valor NET" Binding="{Binding ValorNET}" Width="95"/>
                            <DataGridTextColumn Header="Valor Over" Binding="{Binding ValorOver}" Width="95"/>
                            <DataGridTextColumn Header="Inadimplente" Binding="{Binding Inadimplente}" Width="100"/>
                            <DataGridTextColumn Header="Cartão" Binding="{Binding Cartao}" Width="150"/>
                            <DataGridTextColumn Header="Certif. normalizado" Binding="{Binding CertificadoNormalizado}" Width="135"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AvisosText"
                               Foreground="{StaticResource WarningColor}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,20,0"/>
                    <Button Grid.Column="1"
                            Content="Fechar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="100"
                            Click="Close_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
